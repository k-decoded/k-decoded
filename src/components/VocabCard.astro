---
// VocabCard.astro
// Renders one or more Korean vocab entries as a visually distinct callout
// box inside a blog post. Drop it into a post's Markdown body wherever you
// want to teach a term, and pass it the `vocab` array from that post's
// frontmatter (see src/content/posts/*.md for the shape).
//
// Usage inside a .mdx post body:
//   <VocabCard vocab={frontmatter.vocab} />
// or with a hand-picked subset:
//   <VocabCard vocab={[{ hangul: "선크림", romanization: "seonkeurim", meaning: "sunscreen" }]} />

interface VocabEntry {
  hangul: string;
  romanization: string;
  meaning: string;
}

interface Props {
  vocab: VocabEntry[];
  title?: string;
}

const { vocab, title = "Korean you just learned" } = Astro.props;
---

{vocab.length > 0 && (
  <aside class="not-prose my-10 rounded-md border border-ink-400/10 bg-cream-200 p-5">
    <p class="text-xs font-semibold uppercase tracking-[0.14em] text-brand-700">{title}</p>
    <ul class="mt-3 space-y-3">
      {vocab.map((entry) => (
        <li class="flex flex-wrap items-baseline gap-x-3 gap-y-1 border-b border-ink-400/10 pb-3 last:border-0 last:pb-0">
          <span class="font-korean font-display text-xl font-semibold text-ink">{entry.hangul}</span>
          <span class="text-sm italic text-ink-400">{entry.romanization}</span>
          <span class="text-sm text-ink-700">— {entry.meaning}</span>
        </li>
      ))}
    </ul>
  </aside>
)}
