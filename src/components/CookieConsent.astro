---
// CookieConsent.astro
// Shows the accept/decline banner and drives Google Consent Mode v2:
// gtag.js itself always loads (see BaseLayout.astro), this component only
// pushes gtag("consent", "update", ...) once the visitor makes a choice,
// so no analytics/ad cookies are set until "Accept". Choice persists in
// localStorage using the same "k-decoded:" key convention as
// myKorea.client.ts. Rendered once, site-wide, from BaseLayout.
---

<div
  id="cookie-consent"
  class="fixed inset-x-0 bottom-0 z-50 hidden border-t border-line bg-cream-50 px-4 py-4 shadow-[0_-4px_16px_rgba(42,38,36,0.08)] sm:px-6"
  role="region"
  aria-label="Cookie consent"
>
  <div class="mx-auto flex max-w-6xl flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <p class="text-sm leading-6 text-ink-700">
      We use cookies for site analytics and advertising. See our
      <a href="/privacy#cookies" class="font-medium text-brand-700 underline hover:text-brand-900">Privacy Policy</a>.
    </p>
    <div class="flex flex-shrink-0 gap-3">
      <button
        type="button"
        id="cookie-decline"
        class="rounded-md border border-line px-4 py-2 text-sm font-medium text-ink-700 transition-colors hover:bg-cream-200 focus:outline-none focus:ring-2 focus:ring-brand-400 focus:ring-offset-2"
      >
        Decline
      </button>
      <button
        type="button"
        id="cookie-accept"
        class="rounded-md bg-ink px-4 py-2 text-sm font-semibold text-cream-50 transition-opacity hover:opacity-90 focus:outline-none focus:ring-2 focus:ring-brand-400 focus:ring-offset-2"
      >
        Accept
      </button>
    </div>
  </div>
</div>

<script>
  const CONSENT_KEY = "k-decoded:cookie-consent";

  const banner = document.getElementById("cookie-consent");
  const acceptButton = document.getElementById("cookie-accept");
  const declineButton = document.getElementById("cookie-decline");

  function updateConsent(granted: boolean): void {
    window.dataLayer = window.dataLayer || [];
    function gtag(...args: unknown[]) {
      window.dataLayer!.push(args);
    }
    const state = granted ? "granted" : "denied";
    gtag("consent", "update", {
      ad_storage: state,
      ad_user_data: state,
      ad_personalization: state,
      analytics_storage: state,
    });
  }

  function showBanner(): void {
    banner?.classList.remove("hidden");
  }

  function hideBanner(): void {
    banner?.classList.add("hidden");
  }

  const consent = localStorage.getItem(CONSENT_KEY);
  if (consent !== "accepted" && consent !== "declined") {
    showBanner();
  }

  acceptButton?.addEventListener("click", () => {
    localStorage.setItem(CONSENT_KEY, "accepted");
    hideBanner();
    updateConsent(true);
  });

  declineButton?.addEventListener("click", () => {
    localStorage.setItem(CONSENT_KEY, "declined");
    hideBanner();
    updateConsent(false);
  });

  // "Cookie Preferences" link (in the footer) re-opens this banner so a
  // visitor can change their mind at any time, per the choice mentioned
  // in the Privacy Policy's Cookies section.
  document.addEventListener("click", (event) => {
    const target = event.target as HTMLElement;
    if (target.closest("[data-cookie-preferences]")) {
      showBanner();
    }
  });

  declare global {
    interface Window {
      dataLayer?: unknown[];
    }
  }
</script>
