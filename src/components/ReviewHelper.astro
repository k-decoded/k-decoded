---
// A small, client-only guide for readers deciding what to look for in a
// product review. It intentionally gives navigation guidance rather than
// pretending to calculate a universal product score.
---

<aside class="not-prose mb-8 rounded-2xl border border-brand-100 bg-brand-50/70 p-5" data-review-helper>
  <p class="text-xs font-semibold uppercase tracking-[0.14em] text-brand-700">Make this review yours</p>
  <h2 class="mt-1 text-lg font-bold text-gray-900">What matters most to you?</h2>
  <div class="mt-3 flex flex-wrap gap-2">
    <button type="button" class="review-priority rounded-full border border-brand-200 bg-white px-3 py-1.5 text-sm font-semibold text-brand-800 hover:bg-brand-100" data-tip="Look for notes on finish, layering, and everyday wear in the review.">Texture &amp; finish</button>
    <button type="button" class="review-priority rounded-full border border-brand-200 bg-white px-3 py-1.5 text-sm font-semibold text-brand-800 hover:bg-brand-100" data-tip="Check the ingredient and irritation notes, then patch-test any new product.">Sensitive skin</button>
    <button type="button" class="review-priority rounded-full border border-brand-200 bg-white px-3 py-1.5 text-sm font-semibold text-brand-800 hover:bg-brand-100" data-tip="Use the price and repurchase notes to judge day-to-day value.">Value &amp; repurchase</button>
  </div>
  <p class="mt-3 text-sm leading-6 text-gray-700" data-review-tip>Pick a priority to surface the most useful part of this review.</p>
</aside>

<script>
  const helper = document.querySelector<HTMLElement>("[data-review-helper]");
  helper?.querySelectorAll<HTMLButtonElement>(".review-priority").forEach((button) => {
    button.addEventListener("click", () => {
      const tip = helper.querySelector<HTMLElement>("[data-review-tip]");
      if (tip) tip.textContent = button.dataset.tip ?? "";
      helper.querySelectorAll(".review-priority").forEach((item) => item.classList.remove("bg-brand-200"));
      button.classList.add("bg-brand-200");
    });
  });
</script>
