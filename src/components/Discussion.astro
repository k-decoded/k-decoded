---
// Discussion.astro
// Embeds a GitHub Discussions thread via giscus (https://giscus.app) —
// free, no server, no database. Which thread it shows is decided by the
// current page's URL (data-mapping="pathname"), so each page that
// includes this component gets its own thread automatically, filed
// under the repo's "General" category. Same setup used for the old
// per-post comments, reused here for the /community boards.

const GISCUS_REPO = "k-decoded/k-decoded";
const GISCUS_REPO_ID = "R_kgDOT37w0g";
const GISCUS_CATEGORY = "General";
const GISCUS_CATEGORY_ID = "DIC_kwDOT37w0s4DDVmD";
---

<script
  src="https://giscus.app/client.js"
  data-repo={GISCUS_REPO}
  data-repo-id={GISCUS_REPO_ID}
  data-category={GISCUS_CATEGORY}
  data-category-id={GISCUS_CATEGORY_ID}
  data-mapping="pathname"
  data-strict="1"
  data-reactions-enabled="1"
  data-emit-metadata="0"
  data-input-position="top"
  data-theme="preferred_color_scheme"
  data-lang="en"
  crossorigin="anonymous"
  async
></script>
