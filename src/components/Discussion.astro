---
interface Props { identifier?: string; home?: boolean; }
const { identifier, home = false } = Astro.props;
const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
const supabaseKey = import.meta.env.PUBLIC_SUPABASE_PUBLISHABLE_KEY;
---

<section class="grid gap-5" data-forum data-category={identifier ?? ""} data-home={String(home)} data-supabase-url={supabaseUrl} data-supabase-key={supabaseKey}>
  <div class="rounded-2xl border border-brand-100 bg-white p-5 shadow-sm sm:p-6" style="order: -2">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between"><div><h2 class="text-2xl font-bold text-gray-900">{home ? "Community conversations" : "Latest discussions"}</h2><p class="mt-1 text-sm text-gray-600">Questions, tips, and useful little discoveries.</p></div><button type="button" class="inline-flex items-center justify-center gap-2 rounded-full bg-brand-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:-translate-y-0.5 hover:bg-brand-700" data-new-topic><span aria-hidden="true">＋</span> Start a discussion</button></div>
    {home && <div class="mt-5 grid gap-3 sm:grid-cols-[1fr_auto]"><label class="relative"><span class="sr-only">Search discussions</span><span class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-brand-500" aria-hidden="true">⌕</span><input type="search" class="w-full rounded-xl border border-brand-200 bg-brand-50/40 py-2.5 pl-9 pr-3 text-sm outline-none transition focus:border-brand-500 focus:ring-2 focus:ring-brand-100" placeholder="Search discussions" data-forum-search /></label><div class="flex flex-wrap gap-2" data-forum-tabs><button type="button" data-sort="latest" aria-pressed="true" class="rounded-full bg-brand-100 px-3 py-1.5 text-sm font-semibold text-brand-800">Latest</button><button type="button" data-sort="popular" aria-pressed="false" class="rounded-full border border-brand-200 px-3 py-1.5 text-sm">Popular</button><button type="button" data-sort="unanswered" aria-pressed="false" class="rounded-full border border-brand-200 px-3 py-1.5 text-sm">Unanswered</button></div></div>}
  </div>
  {home && <aside class="pastel-note rounded-2xl border border-teal-100 p-5" data-community-welcome><div class="flex items-start gap-3"><span class="k-stamp" aria-hidden="true">안녕</span><div><h3 class="text-lg font-bold text-gray-900">Welcome to the community</h3><p class="mt-1 text-sm leading-6 text-gray-600">Start with a question, share one useful find, or help someone plan their next Korea moment.</p><button type="button" class="mt-3 text-sm font-semibold text-brand-700 hover:underline" data-dismiss-welcome>Got it</button></div></div></aside>}
  {home && <div class="grid gap-3 sm:grid-cols-3" aria-label="Discussion prompts"><button type="button" data-prompt="What is one K-beauty product you would repurchase?" class="rounded-xl border border-brand-100 bg-white p-4 text-left text-sm text-gray-700 transition hover:border-brand-300 hover:bg-brand-50">💄 What would you repurchase?</button><button type="button" data-prompt="What is one Seoul tip you wish you had known sooner?" class="rounded-xl border border-brand-100 bg-white p-4 text-left text-sm text-gray-700 transition hover:border-brand-300 hover:bg-brand-50">✈️ Share a Seoul tip</button><button type="button" data-prompt="What Korean phrase are you practising this week?" class="rounded-xl border border-brand-100 bg-white p-4 text-left text-sm text-gray-700 transition hover:border-brand-300 hover:bg-brand-50">🗣️ Practise a phrase</button></div>}
  <form class="hidden rounded-2xl border border-brand-200 bg-brand-50 p-5 shadow-sm sm:p-6" data-topic-form novalidate><div class="flex items-center justify-between gap-4"><div><h3 class="text-xl font-bold text-gray-900">Start a discussion</h3><p class="mt-1 text-sm text-gray-600">A specific title and a little context helps others answer.</p></div><button type="button" class="text-sm text-gray-600 hover:text-brand-700" data-cancel-topic>Cancel</button></div><div class="mt-5 grid gap-4"><label class="grid gap-1 text-sm font-semibold text-gray-800">Title<input name="title" required minlength="6" maxlength="160" aria-describedby="title-error" class="rounded-xl border border-gray-300 bg-white px-3 py-2.5 font-normal" placeholder="e.g. Which toner pads work for sensitive skin?" /><span id="title-error" class="min-h-5 text-sm text-red-700" data-error="title"></span></label><label class="grid gap-1 text-sm font-semibold text-gray-800">Category<select name="category" required aria-describedby="category-error" class="rounded-xl border border-gray-300 bg-white px-3 py-2.5 font-normal" data-category-select></select><span id="category-error" class="min-h-5 text-sm text-red-700" data-error="category"></span></label><label class="grid gap-1 text-sm font-semibold text-gray-800">What’s on your mind?<textarea name="body" required minlength="20" maxlength="10000" rows="7" aria-describedby="body-error" class="rounded-xl border border-gray-300 bg-white px-3 py-2.5 font-normal" placeholder="Share the context, what you have tried, or your best tip…"></textarea><span id="body-error" class="min-h-5 text-sm text-red-700" data-error="body"></span></label><div class="grid gap-1 text-sm font-semibold text-gray-800"><label for="topic-image">Optional image <span class="font-normal text-gray-500">(JPG, PNG, or WebP; 5 MB max)</span></label><input id="topic-image" type="file" accept="image/jpeg,image/png,image/webp" class="text-sm" data-topic-image /><span class="min-h-5 text-sm text-red-700" data-error="image"></span></div><label class="grid gap-1 text-sm font-semibold text-gray-800">Optional tags <span class="font-normal text-gray-500">(up to 5, comma-separated)</span><input name="tags" maxlength="160" class="rounded-xl border border-gray-300 bg-white px-3 py-2.5 font-normal" placeholder="skincare, Seoul, beginner" /></label><details class="rounded-xl border border-brand-200 bg-white p-4"><summary class="cursor-pointer font-semibold text-brand-800">Preview before publishing</summary><div class="mt-3" data-topic-preview>Start typing to preview your discussion.</div></details><p class="min-h-5 text-sm text-red-700" data-error="form" role="alert"></p><button class="w-full rounded-full bg-brand-600 px-4 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-brand-700 sm:w-fit">Publish discussion</button></div></form>
  <div class="rounded-2xl border border-brand-200 bg-white p-5" data-auth-panel style="order: -1"><h3 class="font-bold text-gray-900">Sign in to join the conversation</h3><p class="mt-1 text-sm text-gray-600">Enter your email and we’ll send a secure sign-in link. Guests can always keep reading.</p><div class="mt-4 grid gap-3 sm:grid-cols-[1fr_auto]"><input type="email" required class="rounded-lg border border-gray-300 px-3 py-2" placeholder="you@example.com" data-auth-email /><button type="button" class="rounded-full bg-brand-600 px-4 py-2 text-sm font-semibold text-white" data-send-link>Email me a link</button></div><div class="mt-3 hidden grid gap-3" data-profile-form><input maxlength="32" class="rounded-lg border border-gray-300 px-3 py-2" placeholder="Choose a display name" data-display-name /><button type="button" class="w-fit rounded-full bg-brand-600 px-4 py-2 text-sm font-semibold text-white" data-save-profile>Save profile</button></div></div>
  <p class="text-sm text-gray-600" data-forum-status aria-live="polite"></p><div class="grid gap-3" data-topic-list><div class="animate-pulse rounded-2xl border border-brand-100 bg-white p-5"><div class="h-4 w-24 rounded bg-brand-100"></div><div class="mt-4 h-6 w-3/4 rounded bg-gray-100"></div><div class="mt-3 h-4 w-full rounded bg-gray-100"></div></div><div class="animate-pulse rounded-2xl border border-brand-100 bg-white p-5"><div class="h-4 w-20 rounded bg-brand-100"></div><div class="mt-4 h-6 w-2/3 rounded bg-gray-100"></div></div></div><button type="button" class="hidden justify-self-center rounded-full border border-brand-200 bg-white px-4 py-2 text-sm font-semibold text-brand-700 transition hover:bg-brand-50" data-load-more>Load more discussions</button>
  <div class="hidden rounded-2xl border border-brand-100 bg-white p-5 text-center shadow-sm" data-join-prompt><p class="font-semibold text-gray-900">Have a useful thought?</p><p class="mt-1 text-sm text-gray-600">Sign in to join the conversation—it only takes an email link.</p><button type="button" class="mt-3 text-sm font-semibold text-brand-700 hover:underline" data-join>Join the conversation</button></div>
  <article class="hidden rounded-2xl border border-brand-100 bg-white p-5 shadow-sm" data-topic-detail><a class="text-sm text-brand-700 hover:underline" href="" data-back>← Back to discussions</a><div class="mt-4" data-topic-content></div><div class="mt-6 border-t border-gray-100 pt-5"><h3 class="font-bold text-gray-900">Replies</h3><div class="mt-4 grid gap-3" data-replies></div></div></article>
</section>

<script>
  // This browser-side Supabase client intentionally uses runtime rows until
  // generated database types are added to the project.
  // @ts-nocheck
  import { createClient } from "@supabase/supabase-js";
  const root = document.querySelector("[data-forum]") as HTMLElement | null;
  if (root) {
    const url = root.dataset.supabaseUrl, key = root.dataset.supabaseKey, category = root.dataset.category || null, home = root.dataset.home === "true";
    const status = root.querySelector<HTMLElement>("[data-forum-status]"), list = root.querySelector<HTMLElement>("[data-topic-list]"), detail = root.querySelector<HTMLElement>("[data-topic-detail]"), content = root.querySelector<HTMLElement>("[data-topic-content]"), repliesEl = root.querySelector<HTMLElement>("[data-replies]"), form = root.querySelector<HTMLFormElement>("[data-topic-form]"), authPanel = root.querySelector<HTMLElement>("[data-auth-panel]"), profileForm = root.querySelector<HTMLElement>("[data-profile-form]");
    let client: ReturnType<typeof createClient> | null = null, categories: any[] = [], offset = 0, sort = "latest", activeId = new URLSearchParams(location.search).get("discussion");
    const say = (message: string) => { if (status) status.textContent = message; };
    const authStatus = document.createElement("p");
    authStatus.className = "hidden rounded-xl border border-brand-100 bg-brand-50 px-4 py-3 text-sm font-medium text-brand-800";
    authStatus.setAttribute("role", "status");
    authStatus.setAttribute("aria-live", "polite");
    authStatus.style.order = "-1";
    authPanel?.insertAdjacentElement("afterend", authStatus);
    const sayAuth = (message: string) => {
      authStatus.textContent = message;
      authStatus.classList.toggle("hidden", !message);
    };
    const escape = (value: string) => value.replace(/[&<>"']/g, c => ({ "&":"&amp;", "<":"&lt;", ">":"&gt;", '"':"&quot;", "'":"&#39;" }[c]!));
    const when = (value: string) => new Intl.DateTimeFormat(undefined, { dateStyle: "medium", timeStyle: "short" }).format(new Date(value));
    const signedIn = async () => !!(await client!.auth.getUser()).data.user;
    const ensureProfile = async () => {
      const { data: { user } } = await client!.auth.getUser();
      if (!user) return;
      const { data: profile } = await client!.from("profiles").select("id").eq("id", user.id).maybeSingle();
      if (!profile) {
        authPanel?.classList.remove("hidden");
        profileForm?.classList.remove("hidden");
        say("You're signed in. Choose a display name before publishing.");
      } else {
        authPanel?.classList.add("hidden");
      }
    };
    const invoke = async (body: Record<string, unknown>) => { const { data, error } = await client!.functions.invoke("community-forum", { body }); if (error) throw error; if (data?.error) throw new Error(data.error); return data; };
    const categoryFor = (id: string) => categories.find(c => c.id === id);
    const card = (topic: any) => `<article data-topic-card data-search="${escape(`${topic.title} ${topic.body} ${topic.author_name_snapshot}`.toLowerCase())}" class="group rounded-2xl border border-brand-100 bg-white p-5 shadow-sm transition duration-200 hover:-translate-y-0.5 hover:border-brand-300 hover:shadow-md"><div class="flex flex-wrap items-center gap-2 text-xs text-gray-500"><span class="rounded-full bg-brand-50 px-2.5 py-1 font-semibold text-brand-800">${escape(categoryFor(topic.category_id)?.name ?? "Community")}</span>${topic.is_locked ? '<span class="rounded-full bg-gray-100 px-2 py-1">Locked</span>' : ''}</div><h3 class="mt-3 text-xl font-bold leading-snug text-gray-900"><a class="transition hover:text-brand-700" href="?discussion=${topic.id}">${escape(topic.title)}</a></h3><p class="mt-2 line-clamp-2 text-sm leading-6 text-gray-600">${escape(topic.body)}</p><div class="mt-5 flex flex-wrap items-center gap-x-3 gap-y-2 border-t border-gray-100 pt-4 text-sm text-gray-500"><span class="inline-flex items-center gap-2"> <b class="grid h-7 w-7 place-items-center rounded-full bg-brand-100 text-xs text-brand-800">${escape(topic.author_name_snapshot.slice(0, 1).toUpperCase())}</b> <strong class="font-medium text-gray-700">${escape(topic.author_name_snapshot)}</strong></span><span>💬 ${topic.reply_count}</span><span>◉ ${topic.view_count}</span><span class="sm:ml-auto">Active ${when(topic.last_activity_at)}</span></div></article>`;
    const loadTopics = async (append = false) => { if (!client || !list) return; say(""); let query = client.from("community_topics").select("*").eq("status", "visible"); if (category) { const match = categories.find(c => c.slug === category); if (match) query = query.eq("category_id", match.id); } if (sort === "unanswered") query = query.eq("reply_count", 0); query = sort === "popular" ? query.order("reply_count", { ascending: false }).order("view_count", { ascending: false }) : query.order("last_activity_at", { ascending: false }); const { data, error } = await query.range(offset, offset + 19); if (error) { say("Discussions are temporarily unavailable."); return; } if (!append) list.replaceChildren(); list.insertAdjacentHTML("beforeend", (data ?? []).map(card).join("") || (append ? "" : '<p class="text-sm text-gray-500">No discussions yet.</p>')); const more = root.querySelector<HTMLElement>("[data-load-more]"); if (more) more.classList.toggle("hidden", (data ?? []).length < 20); offset += (data ?? []).length; };
    const replyMarkup = (reply: any, depth: number) => `<article class="rounded-xl ${depth ? 'ml-4 border-l-2 border-brand-200 bg-brand-50/50' : 'bg-gray-50'} p-4"><p class="text-sm font-semibold text-brand-800">${escape(reply.author_name_snapshot)} <span class="font-normal text-gray-500">${when(reply.created_at)}</span></p><p class="mt-1 whitespace-pre-wrap text-sm text-gray-700">${escape(reply.body)}</p><div class="mt-3 flex flex-wrap gap-3 text-sm"><button data-reply-to="${reply.id}" class="font-semibold text-brand-700">Reply</button><button data-react="${reply.id}" data-target-type="reply" class="text-gray-600">♡ Helpful</button><button data-report="${reply.id}" data-target-type="reply" class="text-gray-600">Report</button><button data-edit-reply="${reply.id}" class="text-gray-600">Edit</button><button data-delete-reply="${reply.id}" class="text-gray-600">Delete</button></div></article>`;
    const showTopic = async (id: string) => { const { data: topic } = await client!.from("community_topics").select("*").eq("id", id).eq("status", "visible").maybeSingle(); if (!topic) { say("Discussion not found."); return; } activeId = id; list?.classList.add("hidden"); root.querySelector<HTMLElement>("[data-load-more]")?.classList.add("hidden"); detail?.classList.remove("hidden"); if (content) content.innerHTML = `<div class="flex flex-wrap gap-2 text-xs text-gray-500"><span class="rounded-full bg-brand-50 px-2 py-1 font-semibold text-brand-800">${escape(categoryFor(topic.category_id)?.name ?? "Community")}</span>${topic.is_locked ? '<span>Locked</span>' : ''}</div><h2 class="mt-3 text-2xl font-bold text-gray-900">${escape(topic.title)}</h2><p class="mt-1 text-sm text-gray-500">By ${escape(topic.author_name_snapshot)} · ${when(topic.created_at)}</p><p class="mt-5 whitespace-pre-wrap leading-7 text-gray-700">${escape(topic.body)}</p><div class="mt-5 flex gap-3 text-sm"><button data-reply-topic class="font-semibold text-brand-700">Reply</button><button data-edit-topic class="text-gray-600">Edit</button><button data-delete-topic class="text-gray-600">Delete</button></div><form class="mt-4 hidden grid gap-2" data-reply-form><textarea required maxlength="10000" rows="4" class="rounded-lg border border-gray-300 px-3 py-2" placeholder="Write a reply"></textarea><input type="hidden" value="" /><button class="w-fit rounded-full bg-brand-600 px-4 py-2 text-sm font-semibold text-white">Post reply</button></form>`; const { data: replies } = await client!.from("community_replies").select("*").eq("topic_id", id).eq("status", "visible").order("created_at"); if (repliesEl) { const children = new Map<string, any[]>(); (replies ?? []).forEach(r => { const parent = r.parent_reply_id || "root"; children.set(parent, [...(children.get(parent) ?? []), r]); }); const render = (parent: string, depth = 0): string => (children.get(parent) ?? []).map(r => replyMarkup(r, Math.min(depth, 2)) + render(r.id, depth + 1)).join(""); repliesEl.innerHTML = render("root") || '<p class="text-sm text-gray-500">No replies yet — be the first to respond.</p>'; } };
    const requestSignIn = () => { authPanel?.classList.remove("hidden"); say("Sign in to post or manage your content."); };
    const welcome = root.querySelector<HTMLElement>("[data-community-welcome]");
    if (localStorage.getItem("k-decoded:community-welcome") === "seen") welcome?.classList.add("hidden");
    root.querySelector("[data-dismiss-welcome]")?.addEventListener("click", () => { localStorage.setItem("k-decoded:community-welcome", "seen"); welcome?.classList.add("hidden"); });
    root.querySelector("[data-join]")?.addEventListener("click", requestSignIn);
    root.querySelectorAll<HTMLButtonElement>("[data-prompt]").forEach(button => button.addEventListener("click", async () => { if (!await signedIn()) return requestSignIn(); form?.classList.remove("hidden"); const body = form?.querySelector<HTMLTextAreaElement>("[name=body]"); if (body) { body.value = button.dataset.prompt ?? ""; body.focus(); body.dispatchEvent(new Event("input", { bubbles: true })); } }));
    root.addEventListener("click", async event => { const button = event.target as HTMLElement; if (!button.matches("[data-react], [data-report]")) return; if (!await signedIn()) return requestSignIn(); try { if (button.dataset.react) { const data = await invoke({ action: "toggle-reaction", target_type: button.dataset.targetType, target_id: button.dataset.react, reaction: "helpful" }); button.textContent = data.active ? "♥ Helpful" : "♡ Helpful"; } else { const reason = prompt("What is the issue with this content?")?.trim(); if (reason) { await invoke({ action: "report-content", target_type: button.dataset.targetType, target_id: button.dataset.report, reason }); say("Thanks — the report has been sent for review."); } } } catch (error) { say(error instanceof Error ? error.message : "Could not complete that action."); } });
    const setFieldError = (field: string, message = "") => { const node = root.querySelector<HTMLElement>(`[data-error="${field}"]`); if (node) node.textContent = message; };
    form?.addEventListener("input", () => { const fd = new FormData(form); const preview = root.querySelector<HTMLElement>("[data-topic-preview]"); if (preview) preview.textContent = `${String(fd.get("title") ?? "Your title")}: ${String(fd.get("body") ?? "Your discussion preview will appear here.")}`; });
    form?.addEventListener("submit", async event => {
      event.preventDefault(); event.stopImmediatePropagation();
      ["title", "category", "body", "image", "form"].forEach(field => setFieldError(field));
      if (!client || !await signedIn()) return requestSignIn();
      const fd = new FormData(form); const title = String(fd.get("title") ?? "").trim(), body = String(fd.get("body") ?? "").trim(), categorySlug = String(fd.get("category") ?? "");
      let invalid = false;
      if (title.length < 6) { setFieldError("title", "Use at least 6 characters."); invalid = true; }
      if (!categorySlug) { setFieldError("category", "Choose a category."); invalid = true; }
      if (body.length < 20) { setFieldError("body", "Add at least 20 characters."); invalid = true; }
      const file = root.querySelector<HTMLInputElement>("[data-topic-image]")?.files?.[0];
      if (file && (!['image/jpeg', 'image/png', 'image/webp'].includes(file.type) || file.size > 5242880)) { setFieldError("image", "Use a JPG, PNG, or WebP under 5 MB."); invalid = true; }
      if (invalid) return;
      try {
        let imagePath: string | undefined;
        if (file) { const { data: { user } } = await client.auth.getUser(); imagePath = `${user!.id}/${crypto.randomUUID()}-${file.name.replace(/[^a-zA-Z0-9._-]/g, "-")}`; const { error } = await client.storage.from("community-images").upload(imagePath, file, { contentType: file.type }); if (error) throw new Error("Could not upload image. Please try again."); }
        const tags = String(fd.get("tags") ?? "").split(",").map(tag => tag.trim()).filter(Boolean);
        const result = await invoke({ action: "create-topic", title, category_slug: categorySlug, body, image_path: imagePath, tags });
        location.href = `/community/${categorySlug}?discussion=${result.id}`;
      } catch (error) { const message = error instanceof Error ? error.message : "Could not publish discussion."; setFieldError("form", message); }
    }, true);
    root.querySelector("[data-forum-search]")?.addEventListener("input", event => {
      const query = (event.target as HTMLInputElement).value.toLowerCase().trim();
      let shown = 0;
      root.querySelectorAll<HTMLElement>("[data-topic-card]").forEach(card => {
        const match = !query || card.dataset.search?.includes(query);
        card.classList.toggle("hidden", !match);
        if (match) shown++;
      });
      say(query && !shown ? "No discussions match that search yet." : "");
    });
    root.addEventListener("click", async event => {
      const target = event.target as HTMLElement;
      const action = target.matches("[data-edit-topic]") ? "update-topic" : target.matches("[data-delete-topic]") ? "delete-topic" : target.matches("[data-edit-reply]") ? "update-reply" : target.matches("[data-delete-reply]") ? "delete-reply" : null;
      if (!action) return;
      event.stopImmediatePropagation();
      if (!await signedIn()) return requestSignIn();
      const id = action.endsWith("topic") ? activeId : target.dataset.editReply ?? target.dataset.deleteReply;
      if (!id) return;
      if (action.startsWith("delete")) { if (!confirm("Delete this content? Replies will remain available.")) return; }
      try {
        if (action.startsWith("update")) { const current = target.closest("article")?.querySelector("p.mt-1")?.textContent ?? ""; const body = prompt("Edit your text", current)?.trim(); if (!body) return; await invoke({ action, id, ...(action === "update-topic" ? { title: prompt("Edit title")?.trim(), body } : { body }) }); }
        else await invoke({ action, id });
        if (activeId) await showTopic(activeId);
      } catch (error) { say(error instanceof Error ? error.message : "You are not permitted to change this content."); }
    }, true);
    root.addEventListener("click", async event => {
      const target = event.target as HTMLElement;
      if (!target.matches("[data-send-link]")) return;
      event.preventDefault();
      event.stopImmediatePropagation();
      const email = root.querySelector<HTMLInputElement>("[data-auth-email]")?.value.trim();
      if (!email) return sayAuth("Enter your email address.");
      const { error } = await client!.auth.signInWithOtp({
        email,
        options: { emailRedirectTo: new URL("/community", location.origin).toString() },
      });
      sayAuth(error ? `Could not send sign-in link: ${error.message}` : "Email sent — check your inbox for the secure sign-in link.");
    }, true);
    queueMicrotask(() => {
      void ensureProfile();
      client?.auth.onAuthStateChange((_event, session) => { if (session) void ensureProfile(); });
    });
    if (!url || !key) say("Community is being connected — please check back shortly."); else { client = createClient(url, key); client.from("community_categories").select("*").order("sort_order").then(async ({ data }) => { categories = data ?? []; const select = root.querySelector<HTMLSelectElement>("[data-category-select]"); if (select) select.innerHTML = categories.map(c => `<option value="${c.slug}" ${c.slug === category ? "selected" : ""}>${escape(c.name)}</option>`).join(""); if (activeId) await showTopic(activeId); else await loadTopics(); }); root.querySelector("[data-new-topic]")?.addEventListener("click", async () => { if (!await signedIn()) return requestSignIn(); form?.classList.remove("hidden"); }); root.querySelector("[data-cancel-topic]")?.addEventListener("click", () => form?.classList.add("hidden")); root.querySelector("[data-load-more]")?.addEventListener("click", () => loadTopics(true)); root.querySelectorAll<HTMLButtonElement>("[data-sort]").forEach(button => button.addEventListener("click", () => { sort = button.dataset.sort!; offset = 0; loadTopics(); })); form?.addEventListener("submit", async e => { e.preventDefault(); const fd = new FormData(form); try { const result = await invoke({ action: "create-topic", title: fd.get("title"), category_slug: fd.get("category"), body: fd.get("body") }); location.href = `?discussion=${result.id}`; } catch (error) { say(error instanceof Error ? error.message : "Could not publish discussion."); } }); root.querySelector("[data-send-link]")?.addEventListener("click", async () => { const email = root.querySelector<HTMLInputElement>("[data-auth-email]")?.value.trim(); if (!email) return say("Enter your email address."); const { error } = await client!.auth.signInWithOtp({ email, options: { emailRedirectTo: location.href } }); say(error ? "Could not send sign-in link." : "Check your inbox for the sign-in link."); }); root.querySelector("[data-save-profile]")?.addEventListener("click", async () => { try { await invoke({ action: "upsert-profile", display_name: root.querySelector<HTMLInputElement>("[data-display-name]")?.value }); profileForm?.classList.add("hidden"); say("Profile saved. You can now post."); } catch (error) { say(error instanceof Error ? error.message : "Could not save profile."); } }); client.auth.getUser().then(async ({ data }) => { if (data.user) { const { data: profile } = await client!.from("profiles").select("id").eq("id", data.user.id).maybeSingle(); if (!profile) profileForm?.classList.remove("hidden"); } }); root.addEventListener("click", async e => { const target = e.target as HTMLElement; if (target.matches("[data-back]")) { e.preventDefault(); location.href = location.pathname; } if (target.matches("[data-reply-topic], [data-reply-to]")) { if (!await signedIn()) return requestSignIn(); const replyForm = root.querySelector<HTMLFormElement>("[data-reply-form]"); if (!replyForm) return; replyForm.classList.remove("hidden"); replyForm.querySelector<HTMLInputElement>("input[type=hidden]")!.value = target.dataset.replyTo ?? ""; } if (target.matches("[data-edit-topic], [data-delete-topic], [data-edit-reply], [data-delete-reply]")) say("Editing and deletion controls are being connected in the next build step."); }); root.addEventListener("submit", async e => { const replyForm = (e.target as HTMLElement).closest<HTMLFormElement>("[data-reply-form]"); if (!replyForm) return; e.preventDefault(); try { await invoke({ action: "create-reply", topic_id: activeId, parent_reply_id: replyForm.querySelector<HTMLInputElement>("input[type=hidden]")?.value, body: replyForm.querySelector<HTMLTextAreaElement>("textarea")?.value }); await showTopic(activeId!); } catch (error) { say(error instanceof Error ? error.message : "Could not post reply."); } }); }
  }
</script>
