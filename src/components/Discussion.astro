---
interface Props {
  identifier: string;
}

const { identifier } = Astro.props;
const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
const supabaseKey = import.meta.env.PUBLIC_SUPABASE_PUBLISHABLE_KEY;
---

<section
  class="rounded-2xl border border-brand-100 bg-white p-5 shadow-sm"
  data-community-discussion
  data-topic={identifier}
  data-supabase-url={supabaseUrl}
  data-supabase-key={supabaseKey}
>
  <div>
    <h2 class="text-xl font-bold text-gray-900">Join the conversation</h2>
    <p class="mt-1 text-sm text-gray-600">No account needed. Pick a display name and safe posts appear straight away.</p>
  </div>

  <form class="mt-5 grid gap-3" data-discussion-form>
    <label class="grid gap-1 text-sm font-semibold text-gray-800">
      Display name
      <input name="authorName" required minlength="2" maxlength="32" autocomplete="nickname" class="rounded-lg border border-gray-300 px-3 py-2 font-normal" placeholder="SeoulSnackFan" />
    </label>
    <label class="grid gap-1 text-sm font-semibold text-gray-800">
      Your thought or question
      <textarea name="body" required minlength="1" maxlength="1000" rows="4" class="rounded-lg border border-gray-300 px-3 py-2 font-normal" placeholder="Share a tip, question, or experience…"></textarea>
    </label>
    <div class="flex flex-wrap items-center gap-3">
      <button type="submit" class="rounded-full bg-brand-600 px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-brand-700">Post anonymously</button>
      <p class="text-sm text-gray-600" data-discussion-status aria-live="polite"></p>
    </div>
  </form>

  <div class="mt-7 border-t border-gray-100 pt-5">
    <h3 class="font-semibold text-gray-900">Community posts</h3>
    <div class="mt-3 grid gap-3" data-discussion-posts></div>
  </div>
</section>

<script>
  import { createClient } from "@supabase/supabase-js";

  const discussionRoot = document.querySelector("[data-community-discussion]");

  if (discussionRoot) {
    const supabaseUrl = discussionRoot.dataset.supabaseUrl;
    const supabaseKey = discussionRoot.dataset.supabaseKey;
    const topic = discussionRoot.dataset.topic;
    const form = discussionRoot.querySelector("[data-discussion-form]");
    const status = discussionRoot.querySelector("[data-discussion-status]");
    const posts = discussionRoot.querySelector("[data-discussion-posts]");

    const setStatus = (message) => {
      if (status) status.textContent = message;
    };

    const renderPosts = (items) => {
      if (!posts) return;
      posts.replaceChildren();
      if (!items.length) {
        const empty = document.createElement("p");
        empty.className = "text-sm text-gray-500";
        empty.textContent = "No posts yet — start the conversation.";
        posts.append(empty);
        return;
      }
      items.forEach((item) => {
        const article = document.createElement("article");
        article.className = "rounded-xl bg-brand-50/60 p-4";
        const author = document.createElement("p");
        author.className = "text-sm font-semibold text-brand-800";
        author.textContent = item.author_name;
        const body = document.createElement("p");
        body.className = "mt-1 whitespace-pre-wrap text-sm leading-6 text-gray-700";
        body.textContent = item.body;
        article.append(author, body);
        posts.append(article);
      });
    };

    if (!supabaseUrl || !supabaseKey) {
      setStatus("Community is being connected — please check back shortly.");
    } else {
      const supabase = createClient(supabaseUrl, supabaseKey);

      const loadPosts = async () => {
        const { data, error } = await supabase
          .from("community_posts")
          .select("author_name, body, created_at")
          .eq("topic_slug", topic)
          .eq("status", "approved")
          .order("created_at", { ascending: false });
        if (error) {
          setStatus("Posts are temporarily unavailable.");
          return;
        }
        renderPosts(data ?? []);
      };

      const getSession = async () => {
        const { data: { session } } = await supabase.auth.getSession();
        if (session) return session;
        const { data, error } = await supabase.auth.signInAnonymously();
        if (error) throw error;
        return data.session;
      };

      form?.addEventListener("submit", async (event) => {
        event.preventDefault();
        const formData = new FormData(form);
        const authorName = String(formData.get("authorName") ?? "").trim();
        const body = String(formData.get("body") ?? "").trim();
        if (authorName.length < 2 || body.length < 1) return;

        setStatus("Posting…");
        try {
          const session = await getSession();
          if (!session?.user) throw new Error("No session");
          const { data, error } = await supabase.functions.invoke("moderate-community-post", {
            body: {
              topic_slug: topic,
              author_name: authorName,
              body,
            },
          });
          if (error) throw error;
          form.reset();
          if (data?.status === "approved") {
            setStatus("Posted — thanks for joining the conversation!");
            await loadPosts();
          } else {
            setStatus("Thanks! This post is being reviewed before it appears.");
          }
        } catch {
          setStatus("Couldn’t submit your post. Please try again shortly.");
        }
      });

      loadPosts();
    }
  }
</script>
