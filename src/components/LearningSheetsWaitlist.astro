<aside class="not-prose rounded-md border border-line bg-brand-50 p-6 sm:p-8">
  <div class="max-w-2xl">
    <p class="text-xs font-semibold uppercase tracking-[0.18em] text-brand-700">The Korea Decode</p>
    <h2 class="mt-3 font-display text-3xl font-semibold text-ink sm:text-4xl">One useful Korea email each week.</h2>
    <p class="mt-3 leading-7 text-ink-400">Travel ideas. Korean phrases. Beauty finds. Places worth saving. New K-Decoded guides. First up: printable Korean learning sheets, made to keep.</p>
    <form class="mt-6 flex max-w-xl flex-col gap-3 sm:flex-row sm:flex-wrap" data-learning-waitlist>
      <label class="sr-only" for="learning-sheet-email">Email address</label>
      <input id="learning-sheet-email" type="email" name="email" autocomplete="email" required placeholder="you@example.com" class="min-w-0 flex-1 rounded-md border border-line bg-cream-50 px-3 py-3 text-sm text-ink outline-none transition focus:border-brand-500 focus:ring-1 focus:ring-brand-500" />
      <button type="submit" class="flex-shrink-0 rounded-md bg-ink px-5 py-3 text-xs font-semibold uppercase tracking-[0.14em] text-cream-50 transition-opacity hover:opacity-90 focus:outline-none focus:ring-2 focus:ring-brand-400 focus:ring-offset-2">Decode Korea with me →</button>
      <label class="flex w-full items-start gap-2 text-xs leading-5 text-ink-400"><input type="checkbox" name="consent" required class="mt-0.5" />I agree that K-Decoded may email me about the learning-sheet launch and related updates. I can unsubscribe anytime.</label>
    </form>
    <p class="mt-3 hidden text-sm font-medium" data-learning-waitlist-status aria-live="polite"></p>
    <p class="mt-3 text-xs leading-5 text-ink-400">Your email is used only for the learning-sheet launch and related updates. See our <a href="/privacy" class="underline">Privacy Policy</a>.</p>
  </div>
</aside>

<script>
  import { createClient } from "@supabase/supabase-js";

  const form = document.querySelector<HTMLFormElement>("[data-learning-waitlist]");
  const status = document.querySelector<HTMLElement>("[data-learning-waitlist-status]");
  const url = import.meta.env.PUBLIC_SUPABASE_URL;
  const key = import.meta.env.PUBLIC_SUPABASE_PUBLISHABLE_KEY;
  if (form && status && url && key) {
    const client = createClient(url, key);
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const submit = form.querySelector<HTMLButtonElement>("button[type=submit]");
      const email = new FormData(form).get("email");
      submit?.setAttribute("disabled", "true");
      if (submit) submit.textContent = "Saving…";
      const { error } = await client.functions.invoke("learning-sheet-waitlist", { body: { email, consent: true, source: "website" } });
      status.classList.remove("hidden", "text-red-700", "text-green-700");
      if (error) {
        status.classList.add("text-red-700");
        status.textContent = "We couldn’t save your spot. Please try again.";
        submit?.removeAttribute("disabled");
        if (submit) submit.textContent = "Decode Korea with me →";
      } else {
        status.classList.add("text-green-700");
        status.textContent = "You’re on the early-access list—thank you!";
        form.reset();
        form.classList.add("opacity-60", "pointer-events-none");
      }
    });
  }
</script>


