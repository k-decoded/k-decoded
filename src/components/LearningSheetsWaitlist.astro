<aside class="not-prose relative overflow-hidden rounded-3xl border border-brand-200 bg-gradient-to-br from-brand-50 via-white to-violet-50 p-6 shadow-sm sm:p-8">
  <div class="pointer-events-none absolute -right-8 -top-8 h-28 w-28 rounded-full bg-violet-200/50 blur-2xl" aria-hidden="true"></div>
  <div class="relative max-w-2xl">
    <p class="text-sm font-semibold uppercase tracking-[0.16em] text-brand-700">Coming soon</p>
    <h2 class="mt-2 text-2xl font-bold text-gray-900 sm:text-3xl">Korean learning sheets, made to keep.</h2>
    <p class="mt-3 leading-7 text-gray-600">Printable PDF learning sheets for useful words, travel moments, and K-beauty vocabulary—designed for quick, practical study.</p>
    <form class="mt-5 flex max-w-xl flex-col gap-3 sm:flex-row sm:flex-wrap" data-learning-waitlist>
      <label class="sr-only" for="learning-sheet-email">Email address</label>
      <input id="learning-sheet-email" type="email" name="email" autocomplete="email" required placeholder="you@example.com" class="min-w-0 flex-1 rounded-full border border-brand-200 bg-white px-4 py-3 text-sm text-gray-900 outline-none transition focus:border-brand-500 focus:ring-2 focus:ring-brand-100" />
      <button type="submit" class="rounded-full bg-brand-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:-translate-y-0.5 hover:bg-brand-700">Join early access</button>
      <label class="flex w-full items-start gap-2 text-xs leading-5 text-gray-600"><input type="checkbox" name="consent" required class="mt-0.5" />I agree that K-Decoded may email me about the learning-sheet launch and related updates. I can unsubscribe anytime.</label>
    </form>
    <p class="mt-3 hidden text-sm font-medium" data-learning-waitlist-status aria-live="polite"></p>
    <p class="mt-3 text-xs leading-5 text-gray-500">Your email is used only for the learning-sheet launch and related updates. See our <a href="/privacy" class="underline">Privacy Policy</a>.</p>
  </div>
</aside>

<script>
  import { createClient } from "@supabase/supabase-js";

  const form = document.querySelector<HTMLFormElement>("[data-learning-waitlist]");
  const status = document.querySelector<HTMLElement>("[data-learning-waitlist-status]");
  const url = import.meta.env.PUBLIC_SUPABASE_URL;
  const key = import.meta.env.PUBLIC_SUPABASE_PUBLISHABLE_KEY;
  if (form && status && url && key) {
    const client = createClient(url, key);
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const submit = form.querySelector<HTMLButtonElement>("button[type=submit]");
      const email = new FormData(form).get("email");
      submit?.setAttribute("disabled", "true");
      if (submit) submit.textContent = "Saving…";
      const { error } = await client.functions.invoke("learning-sheet-waitlist", { body: { email, consent: true, source: "website" } });
      status.classList.remove("hidden", "text-red-700", "text-green-700");
      if (error) {
        status.classList.add("text-red-700");
        status.textContent = "We couldn’t save your spot. Please try again.";
        submit?.removeAttribute("disabled");
        if (submit) submit.textContent = "Join early access";
      } else {
        status.classList.add("text-green-700");
        status.textContent = "You’re on the early-access list—thank you!";
        form.reset();
        form.classList.add("opacity-60", "pointer-events-none");
      }
    });
  }
</script>


