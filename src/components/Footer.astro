---
// Footer.astro
// Site-wide footer — editorial redesign. Absorbs the About/Contact
// links and social icons that used to live in Nav.astro (moved here to
// keep the header airy per the homepage redesign), plus a new
// Affiliate Disclosure link pointing at the existing copy already in
// privacy.astro rather than a duplicate new page.
// The year is computed at build time, so it's always current.

const year = new Date().getFullYear();

const linkColumns = [
  { label: "Travel", href: "/tags/travel" },
  { label: "Beauty", href: "/category/beauty" },
  { label: "Food", href: "/category/food" },
  { label: "Korean", href: "/vocab" },
  { label: "Culture", href: "/category/culture" },
  { label: "About", href: "/about" },
  { label: "Contact", href: "/contact" },
];

const legalLinks = [
  { label: "Privacy Policy", href: "/privacy" },
  { label: "Affiliate Disclosure", href: "/privacy#affiliate-links" },
  { label: "Terms of Use", href: "/terms" },
];

const socialLinks = [
  { label: "Pinterest", href: "https://jp.pinterest.com/kdecoded/", icon: "pinterest" },
  { label: "Instagram", href: "https://www.instagram.com/kdec.oded/?hl=en", icon: "instagram" },
];
---

<footer class="border-t border-line bg-ink">
  <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <div class="flex flex-col gap-10 sm:flex-row sm:justify-between">
      <div class="max-w-xs">
        <p class="font-display text-xl font-semibold text-cream-50">K-Decoded</p>
        <p class="mt-2 text-sm leading-6 text-cream-50/70">Korea, decoded for curious travellers.</p>
        <div class="mt-5 flex items-center gap-4">
          {socialLinks.map((social) => (
            <a
              href={social.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Follow K-Decoded on ${social.label}`}
              class="text-cream-50/80 transition-colors hover:text-brand-300 focus:outline-none focus:ring-2 focus:ring-brand-300 focus:ring-offset-2 focus:ring-offset-ink"
            >
              {social.icon === "instagram" && (
                <svg viewBox="0 0 24 24" class="h-5 w-5 fill-none stroke-current stroke-[1.8]" aria-hidden="true">
                  <rect x="3" y="3" width="18" height="18" rx="5" />
                  <circle cx="12" cy="12" r="4" />
                  <circle cx="17.5" cy="6.5" r="1" class="fill-current stroke-none" />
                </svg>
              )}
              {social.icon === "pinterest" && (
                <svg viewBox="0 0 24 24" class="h-5 w-5 fill-current" aria-hidden="true">
                  <path d="M12 2a10 10 0 0 0-3.64 19.31c-.05-1.64-.01-3.61.38-5.3l1.3-5.5s-.32-.64-.32-1.59c0-1.49.86-2.6 1.93-2.6.91 0 1.35.68 1.35 1.5 0 .91-.58 2.27-.88 3.53-.25 1.05.53 1.91 1.57 1.91 1.89 0 3.16-2.42 3.16-5.29 0-2.18-1.47-3.81-4.14-3.81-3.02 0-4.9 2.25-4.9 4.76 0 .87.26 1.48.67 1.96.19.22.21.31.14.57l-.21.84c-.07.27-.28.37-.51.27-1.43-.58-2.1-2.14-2.1-3.89 0-2.89 2.44-6.36 7.28-6.36 3.89 0 6.45 2.81 6.45 5.82 0 3.99-2.22 6.97-5.49 6.97-1.1 0-2.13-.59-2.48-1.25l-.68 2.7c-.41 1.71-1.21 3.41-1.95 4.74A10 10 0 1 0 12 2Z" />
                </svg>
              )}
            </a>
          ))}
        </div>
      </div>

      <nav aria-label="Footer">
        <ul class="grid grid-cols-2 gap-x-10 gap-y-3 sm:flex sm:flex-col">
          {linkColumns.map((item) => (
            <li>
              <a href={item.href} class="text-sm text-cream-50/80 transition-colors hover:text-brand-300">{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    </div>

    <div class="mt-12 flex flex-col gap-3 border-t border-cream-50/15 pt-6 text-xs text-cream-50/60 sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {year} K-Decoded. All rights reserved.</p>
      <p class="flex flex-wrap gap-x-4">
        {legalLinks.map((item) => (
          <a href={item.href} class="hover:text-brand-300 hover:underline">{item.label}</a>
        ))}
      </p>
    </div>
  </div>
</footer>
