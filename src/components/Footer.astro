---
// Footer.astro
// Simple site footer. The year is computed at build time, so it's always
// current without you having to update it by hand.
const year = new Date().getFullYear();
---

<footer class="border-t border-gray-100 bg-gray-50">
  <div class="mx-auto max-w-5xl px-4 py-8 text-sm text-gray-500 sm:px-6">
    <p>&copy; {year} K-Decoded. All rights reserved.</p>
    <p class="mt-1">
      Korea, translated — beauty, fashion, and the language behind them.
    </p>
  </div>
</footer>
