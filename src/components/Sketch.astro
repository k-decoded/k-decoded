---
// Sketch.astro
// Small hand-drawn-style line-sketch decorations — a lipstick, a bowl of
// food, and the Korean flag — used as decorative accents around the
// site instead of abstract shapes. These read as directly "K-beauty" /
// "Korea" rather than generic decoration, which is the whole point of
// using them over plain sparkles/stars.
//
// Purely decorative (aria-hidden). `animated` set true gives it the
// gentle idle twinkle/wiggle used in the hero; false leaves it static
// (e.g. for a hover-triggered reveal, where the parent controls opacity
// instead).

interface Props {
  type: "lipstick" | "food" | "flag";
  class?: string;
  color?: string;
  delay?: number;
  animated?: boolean;
}

const {
  type,
  class: className = "",
  color = "text-brand-400",
  delay = 0,
  animated = true,
} = Astro.props;

const sharedClasses = [color, className, animated && "animate-twinkle"];
const sharedStyle = animated ? `animation-delay: ${delay}s` : undefined;
---

{type === "lipstick" && (
  <svg
    aria-hidden="true"
    viewBox="0 0 40 40"
    fill="none"
    stroke="currentColor"
    stroke-width="1.75"
    stroke-linecap="round"
    stroke-linejoin="round"
    class:list={sharedClasses}
    style={sharedStyle}
  >
    <rect x="14" y="18" width="12" height="15" rx="2" />
    <path d="M14 18 L16 8 L24 8 L26 18" />
    <line x1="14" y1="23" x2="26" y2="23" />
  </svg>
)}

{type === "food" && (
  <svg
    aria-hidden="true"
    viewBox="0 0 40 40"
    fill="none"
    stroke="currentColor"
    stroke-width="1.75"
    stroke-linecap="round"
    stroke-linejoin="round"
    class:list={sharedClasses}
    style={sharedStyle}
  >
    <path d="M7 19 Q7 30 20 30 Q33 30 33 19 Z" />
    <line x1="6" y1="19" x2="34" y2="19" />
    <path d="M14 19 Q14 12 20 12 Q26 12 26 19" />
    <line x1="27" y1="9" x2="30" y2="16" />
    <line x1="30" y1="9" x2="27" y2="16" />
  </svg>
)}

{type === "flag" && (
  <svg
    aria-hidden="true"
    viewBox="0 0 48 32"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    class:list={sharedClasses}
    style={sharedStyle}
  >
    <rect x="1.5" y="1.5" width="45" height="29" rx="3" />
    <circle cx="24" cy="16" r="7" />
    <path d="M24,9 A7,7 0 0,1 24,23 A3.5,3.5 0 0,1 24,16 A3.5,3.5 0 0,0 24,9 Z" />
    <!-- Four corner marks, a loose sketch of the flag's trigram bars —
         not vexillologically exact, just enough to read as flag-like at
         small decorative sizes. -->
    <line x1="6" y1="7" x2="12" y2="7" />
    <line x1="6" y1="9.5" x2="12" y2="9.5" />
    <line x1="6" y1="12" x2="12" y2="12" />

    <line x1="36" y1="7" x2="42" y2="7" />
    <line x1="36" y1="9.5" x2="38.5" y2="9.5" />
    <line x1="39.5" y1="9.5" x2="42" y2="9.5" />
    <line x1="36" y1="12" x2="42" y2="12" />

    <line x1="6" y1="20" x2="12" y2="20" />
    <line x1="6" y1="22.5" x2="8.5" y2="22.5" />
    <line x1="9.5" y1="22.5" x2="12" y2="22.5" />
    <line x1="6" y1="25" x2="12" y2="25" />

    <line x1="36" y1="20" x2="38.5" y2="20" />
    <line x1="39.5" y1="20" x2="42" y2="20" />
    <line x1="36" y1="22.5" x2="42" y2="22.5" />
    <line x1="36" y1="25" x2="38.5" y2="25" />
    <line x1="39.5" y1="25" x2="42" y2="25" />
  </svg>
)}
