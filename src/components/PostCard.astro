---
// PostCard.astro
// A single post preview: title, date, description, and tags. Used on the
// homepage (featured posts) and the blog listing page. Takes a Content
// Collection entry directly so callers don't have to unpack fields.

import type { CollectionEntry } from "astro:content";
import { getTagColor } from "../lib/tagColors";
import Sketch from "./Sketch.astro";

interface Props {
  post: CollectionEntry<"posts">;
}

const { post } = Astro.props;
const { title, description, date, tags, heroImage } = post.data;

const formattedDate = date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<article class="group relative overflow-hidden rounded-2xl border border-gray-100 bg-white transition-all duration-200 hover:-translate-y-1 hover:border-brand-100 hover:shadow-xl" data-post-tags={tags.join(",")}>
  <span class="k-stamp absolute right-4 top-4 z-10" aria-hidden="true">K·D</span>
  <a href={`/blog/${post.slug}`}>
    <!-- heroImage is optional on a post — cards for posts without one just
         skip straight to the text, no broken image or placeholder box.
         overflow-hidden on the wrapper + scale on the image gives a subtle
         zoom effect on hover without cropping outside the card. -->
    {heroImage && (
      <div class="overflow-hidden">
        <img
          src={heroImage}
          alt={title}
          class="h-52 w-full object-cover transition-transform duration-500 group-hover:scale-105"
          loading="lazy"
        />
      </div>
    )}
    <div class="p-5">
      <div class="flex flex-wrap items-center gap-2">
        {tags.slice(0, 1).map((tag) => (
          <span class:list={["rounded-full px-2.5 py-1 text-xs font-semibold", getTagColor(tag)]}>{tag}</span>
        ))}
        <time datetime={date.toISOString()} class="text-xs uppercase tracking-wide text-gray-400">
          {formattedDate}
        </time>
      </div>
      <h3 class="mt-2 flex items-center gap-1 text-lg font-semibold text-gray-900 group-hover:text-brand-600">
        {title}
        <Sketch
          type="lipstick"
          class="h-5 w-5 flex-shrink-0 opacity-0 transition-opacity duration-300 group-hover:opacity-100"
          color="text-orange-400"
          animated={false}
        />
      </h3>
      <p class="mt-2 line-clamp-2 text-sm leading-6 text-gray-600">{description}</p>
      {tags.length > 1 && (
        <ul class="mt-3 flex flex-wrap gap-2">
          {tags.slice(1).map((tag) => (
            <li class:list={["rounded-full px-2.5 py-1 text-xs font-medium", getTagColor(tag)]}>
              {tag}
            </li>
          ))}
        </ul>
      )}
    </div>
  </a>
</article>
