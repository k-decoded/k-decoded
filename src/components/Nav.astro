---
// Nav.astro
// Site-wide navigation bar — editorial redesign (cream background,
// restrained typography, five content-bucket links instead of the
// previous six loose tag chips). Uses Astro.url.pathname to highlight
// whichever link matches the current page. About/Contact/social links
// and the Mini World Cup game moved to Footer.astro and the Culture
// category page respectively — see the homepage redesign plan.

const navItems = [
  { label: "Travel", href: "/tags/travel" },
  { label: "Beauty", href: "/category/beauty" },
  { label: "Food", href: "/category/food" },
  { label: "Korean", href: "/vocab" },
  { label: "Culture", href: "/category/culture" },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 border-b border-line bg-cream">
  <nav class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-5 sm:px-6">
    <a href="/" class="group flex flex-shrink-0 items-center gap-2 whitespace-nowrap font-display text-xl font-semibold tracking-tight text-ink">
      <!-- Original swirl mark, loosely inspired by the taegeuk motif from
           Korean visual culture — rendered in our own brand pinks (not
           the flag's actual red/blue) so it reads as an original mark
           rather than a copy of a national symbol. Spins playfully on
           hover. aria-hidden because the wordmark text right next to it
           already announces "K-Decoded" to screen readers. -->
      <svg
        aria-hidden="true"
        viewBox="0 0 32 32"
        class="h-6 w-6 flex-shrink-0 transition-transform duration-500 group-hover:rotate-180"
      >
        <circle cx="16" cy="16" r="16" fill="#d9a7b0" />
        <path
          d="M16,0 A16,16 0 0,1 16,32 A8,8 0 0,1 16,16 A8,8 0 0,0 16,0 Z"
          fill="#b97f8a"
        />
      </svg>
      <span>K-Decoded</span>
    </a>

    <!-- A plain checkbox-driven mobile menu keeps this dependency-free —
         no JS framework needed for something this simple. -->
    <input type="checkbox" id="nav-toggle" class="peer hidden" />
    <label
      for="nav-toggle"
      class="cursor-pointer text-2xl text-ink lg:hidden"
      aria-label="Toggle navigation menu"
    >
      ☰
    </label>

    <ul
      class="hidden items-center gap-8 font-body lg:flex
             peer-checked:absolute peer-checked:left-0 peer-checked:top-full
             peer-checked:flex peer-checked:w-full peer-checked:flex-col
             peer-checked:items-start peer-checked:gap-4 peer-checked:border-t
             peer-checked:border-line peer-checked:bg-cream
             peer-checked:px-4 peer-checked:py-5"
    >
      {navItems.map((item) => (
        <li>
          <a
            href={item.href}
            class:list={[
              "text-xs font-medium uppercase tracking-[0.14em] transition-colors hover:text-brand-700",
              currentPath === item.href ? "text-brand-700" : "text-ink-700",
            ]}
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="flex items-center gap-5">
      <a
        href="/search"
        aria-label="Search"
        class="text-ink-700 transition-colors hover:text-brand-700 focus:outline-none focus:ring-2 focus:ring-brand-400 focus:ring-offset-2"
      >
        <svg viewBox="0 0 24 24" class="h-5 w-5 fill-none stroke-current stroke-[1.8]" aria-hidden="true">
          <circle cx="11" cy="11" r="7" />
          <line x1="21" y1="21" x2="16.65" y2="16.65" />
        </svg>
      </a>
      <a
        href="/my-korea"
        data-my-korea-link="true"
        class:list={[
          "whitespace-nowrap text-xs font-medium uppercase tracking-[0.14em] transition-colors hover:text-brand-700",
          currentPath === "/my-korea" ? "text-brand-700" : "text-ink-700",
        ]}
      >
        ♡ My Korea<span data-my-korea-count class="hidden sm:inline"></span>
      </a>
    </div>
  </nav>
</header>

<script>
  // Returning-visit treatment (no popup, just a text swap): once the
  // visitor has saved anything to My Korea, the nav link quietly grows a
  // count instead of staying a plain label. The count lives in its own
  // span (hidden below the `sm` breakpoint) so "♡ My Korea" alone still
  // fits comfortably on a 375px phone screen without truncating.
  import { getTotalSavedCount } from "../lib/myKorea.client";

  const countEl = document.querySelector<HTMLElement>("[data-my-korea-count]");
  const count = getTotalSavedCount();
  if (countEl && count > 0) {
    countEl.textContent = ` · ${count} saved`;
  }
</script>
