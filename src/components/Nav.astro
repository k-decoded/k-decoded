---
// Nav.astro
// Site-wide navigation bar. Uses Astro.url.pathname to highlight whichever
// link matches the current page.

import { CATEGORIES } from "../lib/categories";
import { getTagColor } from "../lib/tagColors";

// "Home" isn't listed separately — the logo itself links to "/".
const navItems = [
  { label: "Play", href: "/play" },
  { label: "Saved", href: "/saved" },
  { label: "About", href: "/about" },
  { label: "Contact", href: "/contact" },
];

const socialLinks = [
  { label: "X", href: "https://x.com/kdecodedkr", icon: "x" },
  { label: "Instagram", href: "https://www.instagram.com/kdec.oded/?hl=en", icon: "instagram" },
  { label: "Pinterest", href: "https://jp.pinterest.com/kdecoded/", icon: "pinterest" },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 bg-brand-50">
  <nav class="mx-auto flex max-w-5xl items-center justify-between px-4 py-4 sm:px-6">
    <a href="/" class="group flex items-center gap-2 font-heading text-xl font-bold tracking-tight">
      <!-- Original swirl mark, loosely inspired by the taegeuk motif from
           Korean visual culture — rendered in our own brand pinks (not
           the flag's actual red/blue) so it reads as an original mark
           rather than a copy of a national symbol. Spins playfully on
           hover. aria-hidden because the wordmark text right next to it
           already announces "K-Decoded" to screen readers. -->
      <svg
        aria-hidden="true"
        viewBox="0 0 32 32"
        class="h-7 w-7 flex-shrink-0 transition-transform duration-500 group-hover:rotate-180"
      >
        <circle cx="16" cy="16" r="16" fill="#eeb3c3" />
        <path
          d="M16,0 A16,16 0 0,1 16,32 A8,8 0 0,1 16,16 A8,8 0 0,0 16,0 Z"
          fill="#b3536e"
        />
      </svg>
      <span>
        <span class="text-brand-600">K</span><span class="text-gray-900">-Decoded</span>
      </span>
    </a>

    <!-- A plain checkbox-driven mobile menu keeps this dependency-free —
         no JS framework needed for something this simple. -->
    <input type="checkbox" id="nav-toggle" class="peer hidden" />
    <label
      for="nav-toggle"
      class="cursor-pointer text-2xl sm:hidden"
      aria-label="Toggle navigation menu"
    >
      ☰
    </label>

    <ul
      class="hidden flex-col gap-4 sm:flex sm:flex-row sm:items-center sm:gap-6
             peer-checked:absolute peer-checked:left-0 peer-checked:top-full
             peer-checked:flex peer-checked:w-full peer-checked:flex-col
             peer-checked:border-t peer-checked:border-brand-100 peer-checked:bg-brand-50
             peer-checked:px-4 peer-checked:py-4"
    >
      {navItems.map((item) => (
        <li>
          <a
            href={item.href}
            class:list={[
              "text-sm font-medium transition-colors hover:text-brand-600",
              currentPath === item.href ? "text-brand-600" : "text-gray-600",
            ]}
          >
            {item.label}
          </a>
        </li>
      ))}
      <li class="flex items-center gap-1">
        {socialLinks.map((social) => (
          <a
            href={social.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Follow K-Decoded on ${social.label}`}
            class="inline-flex h-8 w-8 items-center justify-center rounded-full text-gray-600 transition-colors hover:bg-brand-100 hover:text-brand-700 focus:outline-none focus:ring-2 focus:ring-brand-400 focus:ring-offset-2"
          >
            <span class="sr-only">{social.label}</span>
            {social.icon === "x" && (
              <svg viewBox="0 0 24 24" class="h-4 w-4 fill-current" aria-hidden="true">
                <path d="M18.9 2.25h3.68l-8.04 9.19L24 21.75h-7.41l-5.8-7.59-6.64 7.59H.47l8.6-9.83L0 2.25h7.6l5.24 6.93 6.06-6.93Zm-1.29 17.3h2.04L6.49 4.33H4.3L17.61 19.55Z" />
              </svg>
            )}
            {social.icon === "instagram" && (
              <svg viewBox="0 0 24 24" class="h-4 w-4 fill-none stroke-current stroke-[1.8]" aria-hidden="true">
                <rect x="3" y="3" width="18" height="18" rx="5" />
                <circle cx="12" cy="12" r="4" />
                <circle cx="17.5" cy="6.5" r="1" class="fill-current stroke-none" />
              </svg>
            )}
            {social.icon === "pinterest" && (
              <svg viewBox="0 0 24 24" class="h-4 w-4 fill-current" aria-hidden="true">
                <path d="M12 2a10 10 0 0 0-3.64 19.31c-.05-1.64-.01-3.61.38-5.3l1.3-5.5s-.32-.64-.32-1.59c0-1.49.86-2.6 1.93-2.6.91 0 1.35.68 1.35 1.5 0 .91-.58 2.27-.88 3.53-.25 1.05.53 1.91 1.57 1.91 1.89 0 3.16-2.42 3.16-5.29 0-2.18-1.47-3.81-4.14-3.81-3.02 0-4.9 2.25-4.9 4.76 0 .87.26 1.48.67 1.96.19.22.21.31.14.57l-.21.84c-.07.27-.28.37-.51.27-1.43-.58-2.1-2.14-2.1-3.89 0-2.89 2.44-6.36 7.28-6.36 3.89 0 6.45 2.81 6.45 5.82 0 3.99-2.22 6.97-5.49 6.97-1.1 0-2.13-.59-2.48-1.25l-.68 2.7c-.41 1.71-1.21 3.41-1.95 4.74A10 10 0 1 0 12 2Z" />
              </svg>
            )}
          </a>
        ))}
      </li>
    </ul>
  </nav>

  <!-- Topic navigation is explicitly labelled so it reads as content
       discovery, rather than a second competing site navigation bar. -->
  <div class="border-t border-brand-100">
    <div class="mx-auto flex max-w-5xl flex-col gap-3 px-4 py-3 sm:flex-row sm:items-center sm:justify-between sm:px-6">
      <div class="flex flex-wrap items-center gap-2">
        <span class="mr-1 text-xs font-semibold uppercase tracking-[0.12em] text-gray-500">Explore by topic</span>
        <ul class="flex flex-wrap gap-2">
          {CATEGORIES.map((category) => (
            <li class="flex-shrink-0">
              <a
                href={`/tags/${category.slug}`}
                class:list={[
                  "rounded-full px-3 py-1 text-xs font-medium transition-opacity hover:opacity-80",
                  getTagColor(category.slug),
                ]}
              >
                {category.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <form action="/search" method="get" class="relative flex-shrink-0 sm:w-64">
        <label for="nav-search" class="sr-only">Search posts</label>
        <span class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-sm text-brand-500" aria-hidden="true">⌕</span>
        <input
          id="nav-search"
          type="search"
          name="q"
          placeholder="Search posts…"
          class="w-full rounded-full border border-brand-200 bg-white py-2 pl-8 pr-3 text-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500"
        />
      </form>
    </div>
  </div>
</header>
