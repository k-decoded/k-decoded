---
// PostEngagement.astro
// View count + emoji reactions, stored in localStorage — no backend, no
// account to set up, works immediately.
// ponytail: this is per-browser, not a real site-wide total — each
// visitor only sees their own device's count. Swap for a shared backend
// (Cloudflare Workers KV, Supabase, etc.) if you need real aggregate
// numbers later.

interface Props {
  slug: string;
  tags?: string[];
}

const { slug, tags = [] } = Astro.props;
const REACTIONS = [
  { emoji: "💡", key: "useful", label: "Useful" },
  { emoji: "✨", key: "trying", label: "Trying this" },
  { emoji: "🔖", key: "saved", label: "Saved" },
];
---

<div class="not-prose flex flex-wrap items-center gap-4 border-t border-gray-100 py-6" data-slug={slug} data-tags={tags.join(",")}>
  <span class="text-sm text-gray-500">
    👁️ <span id="view-count">–</span> views (on this device)
  </span>

  <div class="flex flex-wrap gap-2">
    {REACTIONS.map((r) => (
      <button
        type="button"
        class="reaction-btn rounded-full border border-brand-200 px-3 py-1.5 text-sm transition-colors hover:bg-brand-50 data-[active=true]:bg-brand-100 data-[active=true]:border-brand-400"
        data-key={r.key}
        data-active="false"
      >
        {r.emoji} {r.label} <span class="reaction-count">–</span>
      </button>
    ))}
  </div>

  <button type="button" class="bookmark-btn ml-auto rounded-full border border-teal-200 bg-teal-50 px-3 py-1.5 text-sm font-semibold text-teal-800 transition-colors hover:bg-teal-100">
    ♡ Save to reads
  </button>
  {tags.includes("travel") && (
    <button type="button" class="seoul-list-btn rounded-full border border-orange-200 bg-orange-50 px-3 py-1.5 text-sm font-semibold text-orange-800 transition-colors hover:bg-orange-100">
      + Add to Seoul list
    </button>
  )}
</div>

<script>
  const root = document.querySelector("[data-slug]") as HTMLElement | null;
  const slug = root?.dataset.slug;
  if (root && slug) {
    const viewKey = `views:${slug}`;
    const views = Number(localStorage.getItem(viewKey) ?? 0) + 1;
    localStorage.setItem(viewKey, String(views));
    const viewCountEl = document.getElementById("view-count");
    if (viewCountEl) viewCountEl.textContent = String(views);

    root.querySelectorAll<HTMLButtonElement>(".reaction-btn").forEach((button) => {
      const key = button.dataset.key!;
      const countEl = button.querySelector(".reaction-count")!;
      const countKey = `count:${slug}:${key}`;
      const reactedKey = `reacted:${slug}:${key}`;
      const reacted = localStorage.getItem(reactedKey) === "1";
      button.dataset.active = String(reacted);
      countEl.textContent = String(Number(localStorage.getItem(countKey) ?? 0));

      button.addEventListener("click", () => {
        const wasReacted = button.dataset.active === "true";
        const current = Number(localStorage.getItem(countKey) ?? 0);
        const next = Math.max(0, current + (wasReacted ? -1 : 1));

        localStorage.setItem(countKey, String(next));
        countEl.textContent = String(next);
        button.dataset.active = String(!wasReacted);

        if (wasReacted) {
          localStorage.removeItem(reactedKey);
        } else {
          localStorage.setItem(reactedKey, "1");
        }
      });
    });

    const title = document.querySelector("h1")?.textContent?.trim() ?? slug;
    const bookmarkButton = root.querySelector<HTMLButtonElement>(".bookmark-btn");
    const savedReadsKey = "k-decoded:saved-reads";
    const savedReads = new Set<string>(JSON.parse(localStorage.getItem(savedReadsKey) ?? "[]"));
    function renderBookmark() {
      if (!bookmarkButton) return;
      const saved = savedReads.has(slug);
      bookmarkButton.textContent = saved ? "♥ Saved to reads" : "♡ Save to reads";
      bookmarkButton.setAttribute("aria-pressed", String(saved));
    }
    renderBookmark();
    bookmarkButton?.addEventListener("click", () => {
      savedReads.has(slug) ? savedReads.delete(slug) : savedReads.add(slug);
      localStorage.setItem(savedReadsKey, JSON.stringify([...savedReads]));
      localStorage.setItem(`k-decoded:read-title:${slug}`, title);
      renderBookmark();
    });

    const seoulButton = root.querySelector<HTMLButtonElement>(".seoul-list-btn");
    const seoulListKey = "k-decoded:seoul-list";
    const seoulList = new Set<string>(JSON.parse(localStorage.getItem(seoulListKey) ?? "[]"));
    function renderSeoulList() {
      if (!seoulButton) return;
      const saved = seoulList.has(slug);
      seoulButton.textContent = saved ? "✓ On your Seoul list" : "+ Add to Seoul list";
      seoulButton.setAttribute("aria-pressed", String(saved));
    }
    renderSeoulList();
    seoulButton?.addEventListener("click", () => {
      seoulList.has(slug) ? seoulList.delete(slug) : seoulList.add(slug);
      localStorage.setItem(seoulListKey, JSON.stringify([...seoulList]));
      localStorage.setItem(`k-decoded:seoul-title:${slug}`, title);
      renderSeoulList();
    });
  }
</script>
