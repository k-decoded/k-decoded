---
// PostEngagement.astro
// View count (shared, via Supabase — see supabase/post_views.sql) +
// emoji reactions, stored in localStorage.
// ponytail: reactions/bookmarks/Seoul-list are still per-browser, same
// limitation the view count used to have. Move those to Supabase the
// same way post_views was done if real aggregate counts matter for
// them too.

interface Props {
  slug: string;
  tags?: string[];
  heroImage?: string;
  description?: string;
}

const { slug, tags = [], heroImage, description = "" } = Astro.props;
const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
const supabaseKey = import.meta.env.PUBLIC_SUPABASE_PUBLISHABLE_KEY;
const REACTIONS = [
  { emoji: "💡", key: "useful", label: "Useful" },
  { emoji: "✨", key: "trying", label: "Trying this" },
  { emoji: "🔖", key: "saved", label: "Saved" },
];
---

<div
  class="not-prose flex flex-wrap items-center gap-4 border-t border-gray-100 py-6"
  data-slug={slug}
  data-tags={tags.join(",")}
  data-hero-image={heroImage}
  data-description={description}
  data-supabase-url={supabaseUrl}
  data-supabase-key={supabaseKey}
>
  <span class="text-sm text-gray-500">
    👁️ <span id="view-count">–</span> views
  </span>

  <div class="flex flex-wrap gap-2">
    {REACTIONS.map((r) => (
      <button
        type="button"
        class="reaction-btn rounded-full border border-brand-200 px-3 py-1.5 text-sm transition-colors hover:bg-brand-50 data-[active=true]:bg-brand-100 data-[active=true]:border-brand-400"
        data-key={r.key}
        data-active="false"
      >
        {r.emoji} {r.label} <span class="reaction-count">–</span>
      </button>
    ))}
  </div>

  <button type="button" class="bookmark-btn ml-auto rounded-full border border-teal-200 bg-teal-50 px-3 py-1.5 text-sm font-semibold text-teal-800 transition-colors hover:bg-teal-100" aria-label="Save this guide to My Korea">
    ♡ SAVE
  </button>
  {tags.includes("travel") && (
    <button type="button" class="seoul-list-btn rounded-full border border-orange-200 bg-orange-50 px-3 py-1.5 text-sm font-semibold text-orange-800 transition-colors hover:bg-orange-100" aria-label="Add this place to your My Korea Seoul list">
      + Add to Seoul list
    </button>
  )}
</div>

<script>
  import { createClient } from "@supabase/supabase-js";
  import { toggleSavedRead, isReadSaved, toggleSeoulList, isOnSeoulList, bucketCategories } from "../lib/myKorea.client";

  const root = document.querySelector("[data-slug]") as HTMLElement | null;
  const slug = root?.dataset.slug;
  if (root && slug) {
    const viewCountEl = document.getElementById("view-count");
    const supabaseUrl = root.dataset.supabaseUrl;
    const supabaseKey = root.dataset.supabaseKey;
    if (supabaseUrl && supabaseKey) {
      const supabase = createClient(supabaseUrl, supabaseKey);
      supabase
        .rpc("increment_post_view", { post_slug: slug })
        .then(({ data, error }: { data: number | null; error: unknown }) => {
          if (viewCountEl) viewCountEl.textContent = error || data == null ? "–" : String(data);
        });
    }

    root.querySelectorAll<HTMLButtonElement>(".reaction-btn").forEach((button) => {
      const key = button.dataset.key!;
      const countEl = button.querySelector(".reaction-count")!;
      const countKey = `count:${slug}:${key}`;
      const reactedKey = `reacted:${slug}:${key}`;
      const reacted = localStorage.getItem(reactedKey) === "1";
      button.dataset.active = String(reacted);
      const renderCount = (count: number) => { countEl.textContent = count > 0 ? ` ${count}` : ""; };
      renderCount(Number(localStorage.getItem(countKey) ?? 0));

      button.addEventListener("click", () => {
        const wasReacted = button.dataset.active === "true";
        const current = Number(localStorage.getItem(countKey) ?? 0);
        const next = Math.max(0, current + (wasReacted ? -1 : 1));

        localStorage.setItem(countKey, String(next));
        renderCount(next);
        button.dataset.active = String(!wasReacted);

        if (wasReacted) {
          localStorage.removeItem(reactedKey);
        } else {
          localStorage.setItem(reactedKey, "1");
        }
      });
    });

    const title = document.querySelector("h1")?.textContent?.trim() ?? slug;
    const bookmarkButton = root.querySelector<HTMLButtonElement>(".bookmark-btn");
    function renderBookmark() {
      if (!bookmarkButton) return;
      const saved = isReadSaved(slug!);
      bookmarkButton.textContent = saved ? "♥ SAVED" : "♡ SAVE";
      bookmarkButton.setAttribute("aria-pressed", String(saved));
      bookmarkButton.setAttribute("aria-label", saved ? "Saved to My Korea" : "Save this guide to My Korea");
    }
    renderBookmark();
    bookmarkButton?.addEventListener("click", () => {
      toggleSavedRead(slug!, title);
      renderBookmark();
    });

    const seoulButton = root.querySelector<HTMLButtonElement>(".seoul-list-btn");
    function renderSeoulList() {
      if (!seoulButton) return;
      const saved = isOnSeoulList(slug!);
      seoulButton.textContent = saved ? "✓ On your Seoul list" : "+ Add to Seoul list";
      seoulButton.setAttribute("aria-pressed", String(saved));
      seoulButton.setAttribute("aria-label", saved ? "On your My Korea Seoul list" : "Add this place to your My Korea Seoul list");
    }
    renderSeoulList();
    seoulButton?.addEventListener("click", () => {
      const tags = (root.dataset.tags ?? "").split(",").filter(Boolean);
      toggleSeoulList(slug!, title, {
        image: root.dataset.heroImage || undefined,
        description: root.dataset.description ?? "",
        categories: bucketCategories(tags),
      });
      renderSeoulList();
    });
  }
</script>
