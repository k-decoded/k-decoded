---
// PostEngagement.astro
// View count + emoji reactions, backed by countapi.xyz — the same
// zero-server, zero-signup pattern Comments.astro used (giscus): a free
// public counter API keyed by namespace/key, no backend of our own.
// ponytail: countapi.xyz has no uptime SLA; if it goes down counts just
// stop updating (fails soft, see script below). Swap for a real backend
// (Supabase/Cloudflare KV) if that ever matters.

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const REACTIONS = [
  { emoji: "👍", key: "like" },
  { emoji: "❤️", key: "love" },
  { emoji: "🎉", key: "yay" },
];
---

<div class="not-prose flex flex-wrap items-center gap-4 border-t border-gray-100 py-6" data-slug={slug}>
  <span class="text-sm text-gray-500">
    👁️ <span id="view-count">–</span> views
  </span>

  <div class="flex flex-wrap gap-2">
    {REACTIONS.map((r) => (
      <button
        type="button"
        class="reaction-btn rounded-full border border-brand-200 px-3 py-1.5 text-sm transition-colors hover:bg-brand-50 data-[active=true]:bg-brand-100 data-[active=true]:border-brand-400"
        data-key={r.key}
        data-active="false"
      >
        {r.emoji} <span class="reaction-count">–</span>
      </button>
    ))}
  </div>
</div>

<script>
  const NAMESPACE = "k-decoded";
  const API = "https://api.countapi.xyz";

  const root = document.querySelector("[data-slug]") as HTMLElement | null;
  const slug = root?.dataset.slug;
  if (root && slug) {
    const viewCountEl = document.getElementById("view-count");
    fetch(`${API}/hit/${NAMESPACE}/${slug}-views`)
      .then((r) => r.json())
      .then((data) => {
        if (viewCountEl) viewCountEl.textContent = String(data.value);
      })
      .catch(() => {
        if (viewCountEl) viewCountEl.textContent = "?";
      });

    root.querySelectorAll<HTMLButtonElement>(".reaction-btn").forEach((button) => {
      const key = button.dataset.key!;
      const countEl = button.querySelector(".reaction-count")!;
      const storageKey = `reacted:${slug}:${key}`;
      const alreadyReacted = localStorage.getItem(storageKey) === "1";
      button.dataset.active = String(alreadyReacted);

      fetch(`${API}/get/${NAMESPACE}/${slug}-${key}`)
        .then((r) => r.json())
        .then((data) => {
          countEl.textContent = String(data.value ?? 0);
        })
        .catch(() => {
          countEl.textContent = "?";
        });

      button.addEventListener("click", () => {
        const reacted = button.dataset.active === "true";
        const amount = reacted ? -1 : 1;
        button.dataset.active = String(!reacted);

        fetch(`${API}/update/${NAMESPACE}/${slug}-${key}?amount=${amount}`)
          .then((r) => r.json())
          .then((data) => {
            countEl.textContent = String(data.value);
          })
          .catch(() => {});

        if (reacted) {
          localStorage.removeItem(storageKey);
        } else {
          localStorage.setItem(storageKey, "1");
        }
      });
    });
  }
</script>
