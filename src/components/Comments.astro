---
// Comments.astro
// Embeds Giscus (https://giscus.app) — a free comment widget backed by
// GitHub Discussions on the k-decoded/k-decoded repo. No database, no
// server, no recurring cost — keeps the site fully static. Configured
// via https://giscus.app once Discussions + the giscus GitHub App were
// enabled on the repo.

const GISCUS_REPO = "k-decoded/k-decoded";
const GISCUS_REPO_ID = "R_kgDOT37w0g";
const GISCUS_CATEGORY = "General";
const GISCUS_CATEGORY_ID = "DIC_kwDOT37w0s4DDVmD";
---

<section class="mt-12 border-t border-gray-100 pt-8">
  <h2 class="mb-4 text-xl font-bold text-gray-900">Discussion</h2>
  <script
    src="https://giscus.app/client.js"
    data-repo={GISCUS_REPO}
    data-repo-id={GISCUS_REPO_ID}
    data-category={GISCUS_CATEGORY}
    data-category-id={GISCUS_CATEGORY_ID}
    data-mapping="pathname"
    data-strict="0"
    data-reactions-enabled="1"
    data-emit-metadata="0"
    data-input-position="bottom"
    data-theme="preferred_color_scheme"
    data-lang="en"
    crossorigin="anonymous"
    async
  ></script>
</section>
