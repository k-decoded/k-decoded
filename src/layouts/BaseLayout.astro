---
// BaseLayout.astro
// The shared page shell: <html>/<head>/<body>, global styles, SEO tags,
// nav, and footer. Every page (index, blog posts, tag pages, etc.) wraps
// its own content in this layout instead of repeating this boilerplate.

import "../styles/global.css";
import SEO from "../components/SEO.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description: string;
  image?: string;
}

const { title, description, image } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Google Analytics (GA4). is:inline tells Astro to leave these
         scripts exactly as-is instead of bundling/hashing them — required
         for third-party snippets like this that rely on a specific
         global (gtag) and load order. -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-5ECJ9D8LDN"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag("js", new Date());
      gtag("config", "G-5ECJ9D8LDN");
    </script>

    <!-- Google Fonts: Fredoka (headings), Work Sans (body), Noto Sans KR
         (Korean text). preconnect warms up the connection before the
         stylesheet request, shaving a bit of load time. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Work+Sans:wght@400;500&family=Noto+Sans+KR:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <SEO title={title} description={description} image={image} />
  </head>
  <body class="flex min-h-screen flex-col">
    <Nav />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
