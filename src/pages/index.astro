---
// src/pages/index.astro
// The homepage — editorial redesign. Cream background, serif display
// headlines, magazine-style hierarchy. Nav/Footer chrome changed
// site-wide (see Nav.astro/Footer.astro); everything below is scoped
// to this page only. See the homepage redesign plan for the full
// rationale behind each section's content choices.

import BaseLayout from "../layouts/BaseLayout.astro";
import LearningSheetsWaitlist from "../components/LearningSheetsWaitlist.astro";
import { getCollection } from "astro:content";

const allPosts = await getCollection("posts", ({ data }) => data.draft !== true);

const featuredPosts = allPosts
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 10);

const heroPost = featuredPosts[0];
const editSupporting = featuredPosts.slice(1, 5);

// "Korean of the Day" — a date-seeded pick instead of always the same
// word, so it actually rotates daily rather than being permanently
// stuck on whichever vocab entry happened to load first.
const quizWords = allPosts.flatMap((post) => post.data.vocab);
const dayOfYear = Math.floor(
  (Date.now() - new Date(new Date().getFullYear(), 0, 0).getTime()) / 86400000
);
const wordOfTheDay = quizWords.length ? quizWords[dayOfYear % quizWords.length] : undefined;

// Seasonal feature — same technique the site already used for its
// seasonal-phrase rotator, just computed server-side so the right
// season is in the initial HTML (no client-side flash of the wrong one).
const seasons = [
  { name: "Winter", photo: "/images/posts/gyeongbokgung-palace.png" },
  { name: "Spring", photo: "/images/posts/gamcheon-village-busan-mural-cherry-blossom-window.jpg" },
  { name: "Summer", photo: "/images/posts/haeundae-beach-busan.png" },
  { name: "Autumn", photo: "/images/posts/bukchon-hanok-village-alley.png" },
];
const season = seasons[Math.floor(new Date().getMonth() / 3)];

// "What are you here for?" — five real destinations, five real photos.
// `focal` is a per-image object-position: each photo was shot for a
// different (mostly landscape) crop, so cover-fitting them into the same
// narrow aspect-[3/4] tile needs its own anchor point to keep the actual
// subject in frame instead of an arbitrary center-crop.
const tiles = [
  { label: "Plan Korea", href: "/tags/travel", photo: "/images/posts/first-timer-seoul-itinerary-hero.png", focal: "72% 45%" },
  { label: "K-Beauty", href: "/category/beauty", photo: "/images/posts/glass-skin-101-hero.png", focal: "62% 35%" },
  { label: "Eat Korea", href: "/category/food", photo: "/images/posts/korea-food-trends-tanghulu.jpg", focal: "50% 30%" },
  { label: "Learn Korean", href: "/vocab", photo: "/images/posts/korean-shopping-flatlay.webp", focal: "42% 45%" },
  { label: "Seoul Life", href: "/category/culture", photo: "/images/posts/ihwa-mural-village-seoul.png", focal: "50% 35%" },
];

// "Plan Your Korea Trip" — links to real posts only. "Where to stay"
// is omitted: no accommodation guide exists yet, and a confident 4
// links beats a 5th that goes nowhere useful.
const planLinks = [
  { label: "First-timer's guide", href: "/blog/first-timer-seoul-itinerary-4-days" },
  { label: "Seoul itineraries", href: "/tags/travel" },
  { label: "Transport", href: "/blog/getting-around-seoul-transportation-guide" },
  { label: "Korean phrases", href: "/tags/language" },
];

// "Beauty Decoded" — same rule: real posts only, closest honest match
// where an exact topic post doesn't exist yet (skincare clinics).
const beautyLinks = [
  { label: "Personal Color Analysis", href: "/blog/personal-color-analysis-seoul-guide" },
  { label: "Korean Skincare Clinics", href: "/blog/k-beauty-tourism-boom-2026" },
  { label: "Olive Young Shopping", href: "/blog/tax-free-shopping-korea-olive-young-spao" },
  { label: "Korean Makeup", href: "/blog/fwee-rose-obsession-lip-tint-review" },
  { label: "Hair & Beauty Experiences", href: "/blog/labo-h-scalp-strengthening-roll-on-serum-review" },
];

const seoulListPreview = ["Beauty", "Food", "Cafés", "Shopping", "Places"];
---

<BaseLayout
  title="Home"
  description="K-Decoded is a Korea travel and lifestyle guide — practical, editorial guides to Seoul neighbourhoods, Korean beauty, food, and the language behind them."
>
  <div class="bg-cream">
    <!-- Hero — one photo, one headline, minimal else. -->
    <section class="relative">
      <div class="relative h-[70vh] min-h-[420px] w-full overflow-hidden">
        <img
          src="/images/posts/gyeongbokgung-palace-hero.png"
          alt="Close-up of Gyeongbokgung Palace's dancheong-painted eaves and tiered roofline against a blue sky, Seoul"
          class="h-full w-full object-cover"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-ink/70 via-ink/10 to-transparent"></div>
        <div class="absolute inset-x-0 bottom-0 mx-auto max-w-6xl px-4 pb-12 sm:px-6 sm:pb-16">
          <p class="text-xs font-semibold uppercase tracking-[0.22em] text-cream-100">Korea • Travel • Beauty • Culture</p>
          <h1 class="mt-3 font-display text-5xl font-light leading-[1.05] text-cream-50 sm:text-7xl">Korea,<br />decoded.</h1>
          <p class="mt-5 max-w-lg text-base leading-7 text-cream-100 sm:text-lg">
            Practical guides to experiencing Korea — from Seoul neighbourhoods and Korean beauty to food, language and everyday culture.
          </p>
          <div class="mt-7 flex flex-wrap items-center gap-x-8 gap-y-3">
            <a href="#plan-korea" class="text-xs font-semibold uppercase tracking-[0.16em] text-cream-50 underline decoration-brand-300 underline-offset-8 transition hover:decoration-cream-50">Plan your Korea trip →</a>
            <a href="/blog" class="text-xs font-semibold uppercase tracking-[0.16em] text-cream-100 transition hover:text-cream-50">Explore the latest →</a>
          </div>
        </div>
      </div>
    </section>

    <!-- What are you here for? -->
    <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
      <h2 class="font-display text-3xl font-semibold text-ink sm:text-4xl">What are you here for?</h2>
      <div class="mt-8 grid grid-cols-2 gap-px overflow-hidden bg-line sm:grid-cols-5">
        {tiles.map((tile, index) => (
          <a href={tile.href} class:list={["group relative flex aspect-[3/4] items-end overflow-hidden bg-cream", index === tiles.length - 1 && "col-span-2 sm:col-span-1"]}>
            <img
              src={tile.photo}
              alt=""
              style={{ objectPosition: tile.focal }}
              class="tile-photo absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-ink/60 via-ink/0 to-transparent"></div>
            <span class="relative z-10 p-4 text-xs font-semibold uppercase tracking-[0.14em] text-cream-50">{tile.label}</span>
          </a>
        ))}
      </div>
    </section>

    <!-- The K-Decoded Edit -->
    {heroPost && (
      <section class="mx-auto max-w-6xl border-t border-line px-4 py-16 sm:px-6 sm:py-20">
        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-brand-700">The K-Decoded Edit</p>
        <div class="mt-6 grid gap-10 lg:grid-cols-[1.4fr_1fr]">
          <a href={`/blog/${heroPost.slug}`} class="group block">
            {heroPost.data.heroImage && (
              <div class="aspect-[16/10] overflow-hidden">
                <img src={heroPost.data.heroImage} alt={heroPost.data.title} class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" />
              </div>
            )}
            <h2 class="mt-5 font-display text-3xl font-semibold leading-tight text-ink sm:text-4xl">{heroPost.data.title}</h2>
            <p class="mt-3 max-w-xl leading-7 text-ink-400">{heroPost.data.description}</p>
            <span class="mt-4 inline-block text-xs font-semibold uppercase tracking-[0.14em] text-brand-700 group-hover:text-brand-900">Read the guide →</span>
          </a>

          <div class="space-y-8 divide-y divide-line lg:border-l lg:border-line lg:pl-10">
            {editSupporting.map((post) => (
              <a href={`/blog/${post.slug}`} class="group block pt-8 first:pt-0">
                <time datetime={post.data.date.toISOString()} class="text-xs uppercase tracking-wide text-ink-400">
                  {post.data.date.toLocaleDateString("en-US", { month: "long", day: "numeric" })}
                </time>
                <h3 class="mt-2 font-display text-xl font-semibold leading-snug text-ink group-hover:text-brand-700">{post.data.title}</h3>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- Plan Your Korea Trip -->
    <section id="plan-korea" class="scroll-mt-20 border-t border-line bg-cream-200">
      <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
        <div class="grid gap-10 lg:grid-cols-2">
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.18em] text-brand-700">Plan your Korea trip</p>
            <h2 class="mt-3 font-display text-3xl font-semibold leading-tight text-ink sm:text-4xl">Going to Korea?<br />Start here.</h2>
            <p class="mt-4 max-w-md leading-7 text-ink-400">Everything you need before landing — itineraries, transport, neighbourhoods, seasonal guides and the Korean phrases you'll actually use.</p>
          </div>
          <div>
            <ul class="divide-y divide-line border-t border-line">
              {planLinks.map((link) => (
                <li>
                  <a href={link.href} class="flex items-center justify-between py-4 text-sm font-medium text-ink transition-colors hover:text-brand-700">
                    {link.label} <span aria-hidden="true">→</span>
                  </a>
                </li>
              ))}
            </ul>
            <a href="/my-korea#seoul-list" class="mt-6 inline-block text-xs font-semibold uppercase tracking-[0.16em] text-brand-700 hover:text-brand-900">Build my Korea list →</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Beauty Decoded -->
    <section class="border-t border-line">
      <div class="mx-auto grid max-w-6xl gap-10 px-4 py-16 sm:px-6 sm:py-20 lg:grid-cols-2">
        <div class="aspect-[4/5] overflow-hidden lg:order-2">
          <img src="/images/posts/personal-color-analysis-hero.png" alt="A consultant holding warm and cool color swatches against a client's face during a personal color analysis session in Seoul" class="h-full w-full object-cover" />
        </div>
        <div class="lg:order-1">
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-brand-700">Beauty decoded</p>
          <h2 class="mt-3 font-display text-3xl font-semibold leading-tight text-ink sm:text-4xl">Beauty experiences worth booking in Seoul.</h2>
          <ul class="mt-6 divide-y divide-line border-t border-line">
            {beautyLinks.map((link) => (
              <li>
                <a href={link.href} class="flex items-center justify-between py-4 text-sm font-medium text-ink transition-colors hover:text-brand-700">
                  {link.label} <span aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ul>
          <a href="/category/beauty" class="mt-6 inline-block text-xs font-semibold uppercase tracking-[0.16em] text-brand-700 hover:text-brand-900">Explore K-beauty →</a>
        </div>
      </div>
    </section>

    <!-- Korean of the Day -->
    {wordOfTheDay && (
      <section class="border-t border-line bg-cream-200">
        <div class="mx-auto max-w-2xl px-4 py-16 text-center sm:px-6 sm:py-20">
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-brand-700">Korean of the day</p>
          <p class="mt-6 font-korean text-5xl font-bold text-ink" data-word-hangul>{wordOfTheDay.hangul}</p>
          <p class="mt-2 text-lg italic text-ink-400" data-word-romanization>{wordOfTheDay.romanization}</p>

          <button
            type="button"
            data-word-reveal
            aria-expanded="false"
            class="mt-6 text-xs font-semibold uppercase tracking-[0.16em] text-brand-700 underline decoration-brand-300 underline-offset-4 hover:text-brand-900"
          >
            Tap to reveal meaning
          </button>
          <p class="mt-3 hidden text-base leading-7 text-ink" data-word-meaning aria-live="polite">{wordOfTheDay.meaning}</p>

          <div class="mt-8 flex flex-wrap items-center justify-center gap-x-8 gap-y-3">
            <button type="button" data-word-hear class="hidden text-xs font-semibold uppercase tracking-[0.14em] text-ink-700 hover:text-brand-700">Hear it</button>
            <button type="button" data-word-save aria-pressed="false" class="text-xs font-semibold uppercase tracking-[0.14em] text-ink-700 hover:text-brand-700">♡ Save word</button>
            <a href="/vocab" class="text-xs font-semibold uppercase tracking-[0.14em] text-ink-700 hover:text-brand-700">Learn more Korean →</a>
          </div>
        </div>
      </section>
    )}

    <!-- The Seoul List -->
    <section class="border-t border-line">
      <div class="mx-auto max-w-3xl px-4 py-16 text-center sm:px-6 sm:py-20">
        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-brand-700">The Seoul list</p>
        <h2 class="mt-3 font-display text-3xl font-semibold leading-tight text-ink sm:text-4xl">Save it for Seoul.</h2>
        <p class="mt-4 leading-7 text-ink-400">
          Found a café, neighbourhood, beauty treatment or restaurant you don't want to forget? Save places and guides to your personal Korea list — no account required.
        </p>
        <ul class="mt-7 flex flex-wrap items-center justify-center gap-x-6 gap-y-2">
          {seoulListPreview.map((label) => (
            <li class="text-sm font-medium text-ink-700">♡ {label}</li>
          ))}
        </ul>
        <a href="/my-korea" class="mt-7 inline-block text-xs font-semibold uppercase tracking-[0.16em] text-brand-700 hover:text-brand-900">View my Korea →</a>
      </div>
    </section>

    <!-- Seasonal feature -->
    <section class="relative border-t border-line">
      <div class="relative h-[50vh] min-h-[340px] w-full overflow-hidden">
        <img src={season.photo} alt="" class="h-full w-full object-cover" />
        <div class="absolute inset-0 bg-gradient-to-t from-ink/70 via-ink/10 to-transparent"></div>
        <div class="absolute inset-x-0 bottom-0 mx-auto max-w-6xl px-4 pb-12 sm:px-6 sm:pb-16">
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-cream-100">Korea in {season.name.toLowerCase()}</p>
          <h2 class="mt-2 font-display text-4xl font-light text-cream-50 sm:text-5xl">Korea in {season.name}</h2>
          <a href="/tags/travel" class="mt-5 inline-block text-xs font-semibold uppercase tracking-[0.16em] text-cream-50 underline decoration-brand-300 underline-offset-8">
            See travel guides →
          </a>
        </div>
      </div>
    </section>

    <!-- Email signup -->
    <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
      <LearningSheetsWaitlist />
    </section>
  </div>
</BaseLayout>

<script define:vars={{ wordOfTheDayHangul: wordOfTheDay?.hangul ?? null }}>
  window.__wordOfTheDayHangul = wordOfTheDayHangul;
</script>

<script>
  import { toggleSavedWord, isWordSaved } from "../lib/myKorea.client";

  declare global {
    interface Window {
      __wordOfTheDayHangul?: string | null;
    }
  }

  const hangul = window.__wordOfTheDayHangul;

  // Reveal
  const revealButton = document.querySelector<HTMLButtonElement>("[data-word-reveal]");
  const meaning = document.querySelector<HTMLElement>("[data-word-meaning]");
  revealButton?.addEventListener("click", () => {
    meaning?.classList.remove("hidden");
    revealButton.setAttribute("aria-expanded", "true");
    revealButton.textContent = "Meaning revealed";
  });

  // Hear it — browser-native speech synthesis, no audio-file infra.
  // Pronunciation quality depends on the visitor's OS/browser Korean
  // voice support, so the button simply doesn't render if unsupported
  // rather than showing a control that silently does nothing.
  const hearButton = document.querySelector<HTMLButtonElement>("[data-word-hear]");
  if (hearButton && hangul && "speechSynthesis" in window) {
    hearButton.classList.remove("hidden");
    hearButton.addEventListener("click", () => {
      const utterance = new SpeechSynthesisUtterance(hangul);
      utterance.lang = "ko-KR";
      speechSynthesis.speak(utterance);
    });
  }

  // Save word — real integration with My Korea, not a mock.
  const saveButton = document.querySelector<HTMLButtonElement>("[data-word-save]");
  if (saveButton && hangul) {
    function renderSaveButton() {
      const saved = isWordSaved(hangul!);
      saveButton!.textContent = saved ? "♥ Saved" : "♡ Save word";
      saveButton!.setAttribute("aria-pressed", String(saved));
    }
    renderSaveButton();
    saveButton.addEventListener("click", () => {
      toggleSavedWord(hangul!);
      renderSaveButton();
    });
  }
</script>
