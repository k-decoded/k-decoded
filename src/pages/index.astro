---
// src/pages/index.astro
// The homepage. In Astro, any .astro file under src/pages/ automatically
// becomes a route — this file is served at "/".

import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import Sketch from "../components/Sketch.astro";
import { getCollection } from "astro:content";

// getCollection reads every file in src/content/posts/, validates it
// against the schema in src/content/config.ts, and returns it as data.
const allPosts = await getCollection("posts", ({ data }) => {
  // Hide drafts from the live site while still letting you preview them
  // locally by visiting their URL directly.
  return data.draft !== true;
});

// Sort newest-first, then take the top 6 for the homepage — two clean
// rows in the 3-column grid used below.
const featuredPosts = allPosts
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 6);

const leadPost = featuredPosts[0];
const supportingPosts = featuredPosts.slice(1, 5);
const wordOfTheWeek = allPosts.flatMap((post) => post.data.vocab)[0];
const wordAnchor = wordOfTheWeek?.romanization.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
---

<BaseLayout
  title="Home"
  description="K-Decoded translates Korean beauty, fashion, and makeup for people who can't read Korean — and teaches you the language along the way."
>
  <!-- A compact, benefit-led introduction gets visitors to useful content
       quickly while keeping the soft K-beauty visual character. -->
  <section class="relative overflow-hidden bg-gradient-to-br from-brand-50 via-orange-50 to-brand-100 py-12 sm:py-16">
    <!-- Soft blurred color blobs, slowly drifting — the "cosmetic swatch"
         feel. pointer-events-none so they never intercept clicks/taps. -->
    <div class="pointer-events-none absolute -left-16 -top-16 h-64 w-64 animate-float rounded-full bg-brand-200 opacity-40 blur-3xl" aria-hidden="true"></div>
    <div class="pointer-events-none absolute -right-10 top-10 h-72 w-72 animate-float rounded-full bg-orange-200 opacity-40 blur-3xl" style="animation-delay: 2s" aria-hidden="true"></div>
    <div class="pointer-events-none absolute bottom-0 left-1/3 h-56 w-56 animate-float rounded-full bg-teal-200 opacity-30 blur-3xl" style="animation-delay: 4s" aria-hidden="true"></div>

    <!-- Line-sketch accents scattered around the headline — literal
         K-beauty/Korea cues (lipstick, food, the flag) instead of
         abstract stars, with a gentle idle wiggle. -->
    <Sketch type="lipstick" class="pointer-events-none absolute left-[10%] top-12 h-8 w-8" color="text-brand-400" delay={0} />
    <Sketch type="food" class="pointer-events-none absolute right-[13%] top-16 h-9 w-9" color="text-orange-400" delay={0.8} />
    <Sketch type="flag" class="pointer-events-none absolute bottom-10 left-[15%] h-8 w-11" color="text-teal-500" delay={1.5} />

    <div class="relative z-10 mx-auto max-w-5xl animate-fade-in-up px-4 text-center sm:px-6">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-brand-700">
        K-Decoded
      </p>
      <h1 class="mx-auto mt-2 max-w-3xl text-4xl font-bold tracking-tight text-gray-900 sm:text-5xl">
        Decode Korean beauty, fashion &amp; everyday culture
      </h1>
      <p class="mx-auto mt-4 max-w-2xl text-base leading-7 text-gray-600 sm:text-lg">
        Clear, useful guides to Korean products, places, and the words behind them.
      </p>
      <div class="mt-7 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a
          href="/blog"
          class="rounded-full bg-gradient-to-r from-brand-600 to-orange-500 px-6 py-3 text-sm font-semibold text-white shadow-md transition-transform duration-200 hover:scale-105 hover:shadow-lg"
        >
          Explore the blog
        </a>
        <a
          href="/vocab"
          class="text-sm font-semibold text-brand-700 underline decoration-brand-300 underline-offset-4 transition-colors hover:text-brand-900"
        >
          Browse the vocab glossary
        </a>
      </div>
    </div>
  </section>

  <!-- Featured posts -->
  <section class="mx-auto max-w-5xl px-4 py-12 sm:px-6 sm:py-16">
    <div class="flex flex-col justify-between gap-3 sm:flex-row sm:items-end">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.16em] text-brand-600">Fresh from Korea</p>
        <h2 class="mt-1 flex items-center gap-2 text-2xl font-bold text-gray-900">
          <span class="h-6 w-1.5 rounded-full bg-gradient-to-b from-brand-500 to-orange-400" aria-hidden="true"></span>
          Latest posts
        </h2>
      </div>
      <a href="/blog" class="text-sm font-semibold text-brand-700 transition-colors hover:text-brand-900">View all posts <span aria-hidden="true">→</span></a>
    </div>
    {leadPost && (
      <a href={`/blog/${leadPost.slug}`} class="featured-story group mt-6 grid overflow-hidden rounded-3xl border border-brand-100 bg-brand-50/50 transition-shadow hover:shadow-xl lg:grid-cols-[1.15fr_0.85fr]">
        <div class="relative min-h-72 overflow-hidden lg:order-2 lg:min-h-full">
          {leadPost.data.heroImage && (
            <img src={leadPost.data.heroImage} alt={leadPost.data.title} class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105" />
          )}
          <span class="k-stamp absolute bottom-5 right-5" aria-hidden="true">K·D</span>
        </div>
        <div class="flex flex-col justify-center p-7 sm:p-10 lg:order-1">
          <p class="text-xs font-semibold uppercase tracking-[0.16em] text-brand-700">Featured guide</p>
          <h3 class="mt-3 text-3xl font-bold leading-tight text-gray-900 sm:text-4xl">{leadPost.data.title}</h3>
          <p class="mt-4 max-w-xl leading-7 text-gray-600">{leadPost.data.description}</p>
          <span class="mt-6 inline-flex w-fit items-center gap-2 text-sm font-semibold text-brand-800">Read the guide <span aria-hidden="true">→</span></span>
        </div>
      </a>
    )}

    <div class="mt-6 grid gap-6 sm:grid-cols-2">
      {supportingPosts.map((post) => <PostCard post={post} />)}
    </div>
    {featuredPosts.length === 0 && (
      <p class="mt-6 text-gray-500">
        No posts yet — add a Markdown file to <code>src/content/posts/</code> to get started.
      </p>
    )}

    <aside class="pastel-note mt-12 grid gap-6 rounded-3xl border border-teal-100 p-6 sm:grid-cols-[auto_1fr_auto] sm:items-center sm:p-8">
      <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-white text-3xl shadow-sm" aria-hidden="true">한</div>
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.14em] text-teal-700">Korean word of the week</p>
        {wordOfTheWeek ? (
          <>
            <h2 class="mt-1 font-korean text-2xl font-bold text-gray-900">{wordOfTheWeek.hangul} <span class="font-body text-base font-medium text-gray-500">{wordOfTheWeek.romanization}</span></h2>
            <p class="mt-1 max-w-2xl text-sm leading-6 text-gray-600">{wordOfTheWeek.meaning}</p>
          </>
        ) : (
          <>
            <h2 class="mt-1 text-xl font-bold text-gray-900">Pick up Korean words with every guide.</h2>
            <p class="mt-1 max-w-2xl text-sm leading-6 text-gray-600">Explore the glossary or practise a few Hangul characters whenever you have a minute.</p>
          </>
        )}
      </div>
      <div class="flex flex-wrap gap-3">
        <a href={wordAnchor ? `/vocab#${wordAnchor}` : "/vocab"} class="rounded-full bg-white px-4 py-2 text-sm font-semibold text-teal-800 shadow-sm ring-1 ring-teal-200 transition-colors hover:bg-teal-100">Learn this word</a>
        <a href="/flashcards" class="rounded-full px-4 py-2 text-sm font-semibold text-teal-800 transition-colors hover:text-teal-950">Try flashcards <span aria-hidden="true">→</span></a>
      </div>
    </aside>
  </section>
</BaseLayout>
