---
import BaseLayout from "../../layouts/BaseLayout.astro";
const url = import.meta.env.PUBLIC_SUPABASE_URL;
const key = import.meta.env.PUBLIC_SUPABASE_PUBLISHABLE_KEY;
---
<BaseLayout title="Community moderation" description="Community moderation dashboard.">
  <section class="mx-auto max-w-5xl px-4 py-12 sm:px-6" data-moderation data-url={url} data-key={key}>
    <a href="/community" class="text-sm font-semibold text-brand-700 hover:underline">← Community</a>
    <div class="mt-4 flex flex-wrap items-end justify-between gap-4"><div><h1 class="text-3xl font-bold text-gray-900">Moderation</h1><p class="mt-1 text-gray-600">Reports, content review, and recent actions.</p></div><p class="text-sm text-gray-600" data-status aria-live="polite"></p></div>
    <div class="mt-7 rounded-2xl border border-brand-100 bg-white p-5 shadow-sm"><label class="text-sm font-semibold text-gray-800">Search content<input class="mt-2 w-full rounded-xl border border-gray-300 px-3 py-2" placeholder="Username, title, or keyword" data-search /></label><button class="mt-3 rounded-full bg-brand-600 px-4 py-2 text-sm font-semibold text-white" data-search-button>Search</button></div>
    <div class="mt-6 grid gap-6 lg:grid-cols-2"><section><h2 class="text-xl font-bold text-gray-900">Open reports</h2><div class="mt-3 grid gap-3" data-reports></div></section><section><h2 class="text-xl font-bold text-gray-900">Search results</h2><div class="mt-3 grid gap-3" data-results></div></section></div>
    <section class="mt-8"><h2 class="text-xl font-bold text-gray-900">Recent moderation actions</h2><div class="mt-3 grid gap-2" data-actions></div></section>
  </section>
</BaseLayout>
<script>
  import { createClient } from "@supabase/supabase-js";
  const root = document.querySelector("[data-moderation]") as HTMLElement | null;
  if (root) { const client = createClient(root.dataset.url!, root.dataset.key!); const status = root.querySelector<HTMLElement>("[data-status]"); const say = (m: string) => { if (status) status.textContent = m; }; const esc = (v: unknown) => String(v ?? "").replace(/[&<>"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]!)); const call = async (body: Record<string, unknown>) => { const { data, error } = await client.functions.invoke("community-forum", { body }); if (error || data?.error) throw new Error(data?.error ?? "Request failed"); return data; }; const render = (items: any[], target: string, row: (item: any) => string, empty: string) => { const el = root.querySelector<HTMLElement>(target); if (el) el.innerHTML = items.length ? items.map(row).join("") : `<p class="rounded-xl bg-gray-50 p-4 text-sm text-gray-500">${empty}</p>`; }; const load = async (query = "") => { try { const data = await call({ action: "moderation-dashboard", query }); render(data.reports, "[data-reports]", r => `<article class="rounded-xl border border-brand-100 bg-white p-4 text-sm"><p class="font-semibold">${esc(r.target_type)} report</p><p class="mt-1 text-gray-600">${esc(r.reason)}</p><p class="mt-2 text-xs text-gray-500">Reporter: ${esc(r.reporter_id)}</p><button data-hide="${r.target_id}" data-type="${r.target_type}" class="mt-3 font-semibold text-brand-700">Hide content</button></article>`, "No open reports."); render([...(data.topics ?? []), ...(data.replies ?? [])], "[data-results]", item => `<article class="rounded-xl border border-brand-100 bg-white p-4 text-sm"><p class="font-semibold">${esc(item.title ?? item.body)}</p><p class="mt-1 text-gray-600">${esc(item.author_name_snapshot)} · ${esc(item.status)}</p><div class="mt-3 flex gap-3"><button data-hide="${item.id}" data-type="${item.title ? 'topic' : 'reply'}" class="font-semibold text-brand-700">Hide</button><button data-suspend="${item.author_id}" class="text-gray-600">Suspend author</button></div></article>`, "Search for a topic, reply, or member."); render(data.actions, "[data-actions]", a => `<p class="rounded-xl bg-gray-50 p-3 text-sm text-gray-600">${esc(a.action)} · ${esc(a.actor_id)} · ${new Date(a.created_at).toLocaleString()}</p>`, "No moderation actions yet."); } catch (error) { say(error instanceof Error ? error.message : "Admin access required."); } }; root.querySelector("[data-search-button]")?.addEventListener("click", () => load((root.querySelector<HTMLInputElement>("[data-search]")?.value ?? "").trim())); root.addEventListener("click", async event => { const b = event.target as HTMLElement; try { if (b.dataset.hide) await call({ action: `moderate-${b.dataset.type}`, id: b.dataset.hide, status: "hidden" }); if (b.dataset.suspend) { const reason = prompt("Suspension reason")?.trim(); if (reason) await call({ action: "suspend-user", user_id: b.dataset.suspend, reason }); } if (b.dataset.hide || b.dataset.suspend) await load(); } catch (error) { say(error instanceof Error ? error.message : "Action failed"); } }); load(); }
</script>
