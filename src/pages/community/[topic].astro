---
// src/pages/community/[topic].astro
// One page per board in COMMUNITY_TOPICS. Each gets its own GitHub
// Discussions thread via Discussion.astro (mapped by this page's own
// pathname, so /community/beauty and /community/travel never collide).

import BaseLayout from "../../layouts/BaseLayout.astro";
import Discussion from "../../components/Discussion.astro";
import { COMMUNITY_TOPICS } from "../../lib/communityTopics";

export async function getStaticPaths() {
  return COMMUNITY_TOPICS.map((topic) => ({
    params: { topic: topic.slug },
    props: { topic },
  }));
}

const { topic } = Astro.props;
---

<BaseLayout
  title={`${topic.label} — Community`}
  description={topic.description}
>
  <section class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
    <a href="/community" class="text-sm text-brand-600 hover:underline">← All boards</a>

    <h1 class="mt-3 text-3xl font-bold text-gray-900">{topic.emoji} {topic.label}</h1>
    <p class="mt-2 text-gray-600">{topic.description}</p>

    <div class="mt-10">
      <Discussion />
    </div>
  </section>
</BaseLayout>
