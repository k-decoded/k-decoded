---
// src/pages/blog/[slug].astro
// A "dynamic route" — the [slug] in the filename becomes a URL param.
// getStaticPaths tells Astro every value that param can take, and Astro
// pre-renders one static HTML page per value at build time.

import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import VocabCard from "../../components/VocabCard.astro";
import ProductReview from "../../components/ProductReview.astro";
import Comments from "../../components/Comments.astro";
import { getTagColor } from "../../lib/tagColors";

export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) => data.draft !== true);

  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<"posts">;
}

const { post } = Astro.props;
const { title, description, date, tags, vocab, isReview, product, heroImage } = post.data;

// post.render() compiles the Markdown body into a renderable <Content />
// component — this is how the actual post text gets onto the page.
const { Content } = await post.render();

const formattedDate = date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<BaseLayout title={title} description={description} image={heroImage}>
  <article class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
    <header class="mb-8">
      <time datetime={date.toISOString()} class="text-xs uppercase tracking-wide text-gray-400">
        {formattedDate}
      </time>
      <h1 class="mt-2 text-3xl font-extrabold text-gray-900 sm:text-4xl">{title}</h1>
      <p class="mt-3 text-gray-600">{description}</p>

      {tags.length > 0 && (
        <ul class="mt-4 flex flex-wrap gap-2">
          {tags.map((tag) => (
            <li>
              <a
                href={`/tags/${tag}`}
                class:list={["rounded-full px-2.5 py-1 text-xs font-medium transition-opacity hover:opacity-80", getTagColor(tag)]}
              >
                {tag}
              </a>
            </li>
          ))}
        </ul>
      )}
    </header>

    {heroImage && (
      <img src={heroImage} alt={title} class="mb-8 w-full rounded-xl object-cover" />
    )}

    {isReview && product && <ProductReview product={product} />}

    <!-- `prose` (from @tailwindcss/typography) styles the raw Markdown
         output — headings, paragraphs, lists — without us hand-styling
         every element the post body might contain. -->
    <div class="prose prose-brand max-w-none">
      <Content />
    </div>

    <VocabCard vocab={vocab} />

    <Comments />
  </article>
</BaseLayout>
