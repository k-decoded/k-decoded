---
// src/pages/blog/[slug].astro
// A "dynamic route" — the [slug] in the filename becomes a URL param.
// getStaticPaths tells Astro every value that param can take, and Astro
// pre-renders one static HTML page per value at build time.

import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import VocabCard from "../../components/VocabCard.astro";
import ProductReview from "../../components/ProductReview.astro";
import ReviewHelper from "../../components/ReviewHelper.astro";
import ShareButtons from "../../components/ShareButtons.astro";
import PostEngagement from "../../components/PostEngagement.astro";
import LearningSheetsWaitlist from "../../components/LearningSheetsWaitlist.astro";
import { getTagColor } from "../../lib/tagColors";

export async function getStaticPaths() {
  // Drafts are available on Vercel preview deployments for editorial review,
  // but never included in the production site's generated routes.
  const includeDrafts = import.meta.env.VERCEL_ENV === "preview";
  const posts = await getCollection("posts", ({ data }) => includeDrafts || data.draft !== true);

  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<"posts">;
}

const { post } = Astro.props;
const { title, description, date, tags, vocab, quickDecode, isReview, product, heroImage } = post.data;

// post.render() compiles the Markdown body into a renderable <Content />
// component — this is how the actual post text gets onto the page.
const { Content } = await post.render();

const formattedDate = date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

// Share links need absolute URLs — same pattern SEO.astro uses to build
// them from Astro.site (the canonical domain set in astro.config.mjs).
const absolutePageURL = new URL(Astro.url.pathname, Astro.site).toString();
const absoluteImageURL = heroImage ? new URL(heroImage, Astro.site).toString() : undefined;
const allPosts = await getCollection("posts", ({ data }) => data.draft !== true);
const relatedPosts = allPosts
  .filter((candidate) => candidate.slug !== post.slug && candidate.data.tags.some((tag) => tags.includes(tag)))
  .slice(0, 3);
const readingMinutes = Math.max(1, Math.ceil((post.body?.trim().split(/\s+/).length ?? 0) / 220));
const helpTopic = tags.includes("travel") ? "travel" : "beauty";
const helpPrompt = tags.includes("travel")
  ? "Planning a Korea trip? Ask readers what they would do."
  : "Trying this routine or choosing a product? Ask readers for practical help.";
---

<BaseLayout title={title} description={description} image={heroImage}>
  <article class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
    <div class="mx-auto max-w-2xl">
      <header class="mb-8">
        <p class="text-xs font-semibold uppercase tracking-[0.16em] text-brand-700">
          {tags[0] ?? "Guide"}
        </p>
        <h1 class="mt-2 font-display text-4xl font-semibold leading-tight text-ink sm:text-5xl">{title}</h1>
        <p class="mt-3 text-lg leading-7 text-ink-400">{description}</p>
        <p class="mt-4 text-xs uppercase tracking-wide text-ink-400">
          <time datetime={date.toISOString()}>{formattedDate}</time>
          <span class="mx-1.5">·</span>
          {readingMinutes} min read
        </p>

        {tags.length > 0 && (
          <ul class="mt-4 flex flex-wrap gap-2">
            {tags.map((tag) => (
              <li>
                <a
                  href={`/tags/${tag}`}
                  class:list={["rounded-full px-2.5 py-1 text-xs font-medium transition-opacity hover:opacity-80", getTagColor(tag)]}
                >
                  {tag}
                </a>
              </li>
            ))}
          </ul>
        )}
      </header>
    </div>

    {heroImage && (
      <img src={heroImage} alt={title} loading="eager" class="mb-8 w-full rounded-md object-cover" />
    )}

    <div class="mx-auto max-w-2xl">
      <!-- Real table of contents, built from the article's actual h2
           headings by the script below — not hardcoded per post. -->
      <nav class="not-prose mb-8 hidden rounded-md border border-ink-400/10 bg-white p-5" aria-label="In this guide" data-article-toc>
        <p class="text-xs font-semibold uppercase tracking-[0.14em] text-brand-700">In this guide</p>
        <ol class="mt-3 grid gap-2 text-sm" data-article-toc-list></ol>
      </nav>

      {isReview && product && <ProductReview product={product} />}
      {isReview && <ReviewHelper />}

      {(quickDecode || vocab.length > 0) && (
        <aside class="not-prose mb-8 rounded-md border border-brand-200 bg-cream-200 p-5">
          <p class="text-xs font-semibold uppercase tracking-[0.14em] text-brand-700">K·D — Quick Decode</p>
          {quickDecode ? (
            <>
              <p class="mt-2 font-display text-2xl font-semibold text-ink">{quickDecode.title}</p>
              <p class="mt-1 text-sm leading-6 text-ink-700">{quickDecode.summary}</p>
            </>
          ) : (
            <>
              <p class="mt-2 font-korean font-display text-2xl font-semibold text-ink">{vocab[0].hangul} <span class="font-body text-sm font-medium text-ink-400">{vocab[0].romanization}</span></p>
              <p class="mt-1 text-sm leading-6 text-ink-700">{vocab[0].meaning}</p>
            </>
          )}
        </aside>
      )}

      <!-- `prose` (from @tailwindcss/typography) styles the raw Markdown
           output — headings, paragraphs, lists — without us hand-styling
           every element the post body might contain. Color variables for
           this are set on .article-body in global.css. -->
      <div class="article-body prose max-w-none">
        <Content />
      </div>
    </div>

    <div class="mx-auto max-w-2xl">
      <PostEngagement slug={post.slug} tags={tags} heroImage={heroImage} description={description} />

      <VocabCard vocab={vocab} />

      {relatedPosts.length > 0 && (
        <aside class="not-prose mt-10">
          <h2 class="font-display text-2xl font-semibold text-ink">Decode Next</h2>
          <ul class="mt-4 grid gap-4 sm:grid-cols-3">
            {relatedPosts.map((related) => (
              <li>
                <a href={`/blog/${related.slug}`} class="group block">
                  {related.data.heroImage && (
                    <div class="aspect-[4/3] overflow-hidden rounded-md">
                      <img src={related.data.heroImage} alt="" class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105" />
                    </div>
                  )}
                  <p class="mt-2 text-sm font-semibold leading-5 text-ink group-hover:text-brand-700">{related.data.title}</p>
                </a>
              </li>
            ))}
          </ul>
        </aside>
      )}

      <p class="not-prose mt-8 text-sm text-ink-400">
        {helpPrompt} <a href={`/community/${helpTopic}`} class="font-semibold text-brand-700 hover:underline">Ask a question →</a>
      </p>

      <div class="mt-10"><ShareButtons title={title} url={absolutePageURL} image={absoluteImageURL} /></div>

      <div class="mt-10"><LearningSheetsWaitlist /></div>
    </div>
  </article>
</BaseLayout>

<script>
  const toc = document.querySelector<HTMLElement>("[data-article-toc]");
  const tocList = document.querySelector<HTMLOListElement>("[data-article-toc-list]");
  const headings = [...document.querySelectorAll<HTMLElement>(".article-body h2")];
  if (toc && tocList && headings.length > 1) {
    headings.forEach((heading, index) => {
      const id = heading.id || `section-${index + 1}`;
      heading.id = id;
      const number = String(index + 1).padStart(2, "0");
      tocList.insertAdjacentHTML(
        "beforeend",
        `<li><a class="flex gap-2 text-ink-700 hover:text-brand-700" href="#${id}"><span class="text-brand-700" aria-hidden="true">${number} —</span>${heading.textContent}</a></li>`
      );
    });
    toc.classList.remove("hidden");
  }
</script>
