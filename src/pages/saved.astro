---
// saved.astro
// This page's content moved to /my-korea#reads as part of the My Korea
// feature. Kept alive (rather than deleted) as a redirect so the
// previously-indexed /saved URL doesn't just start 404ing — the
// BaseLayout title/description below are what a crawler or a "Leave
// site?" preview would still see before the redirect fires.
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Saved reads" description="Your saved K-Decoded guides — now part of My Korea.">
  <section class="mx-auto max-w-3xl px-4 py-16 text-center sm:px-6">
    <p class="text-gray-600">Redirecting to My Korea…</p>
    <noscript>
      <p class="mt-3 text-gray-600">
        Your saved reads have moved. <a href="/my-korea" class="font-semibold text-brand-700 underline">Go to My Korea →</a>
      </p>
    </noscript>
  </section>
</BaseLayout>

<script>
  location.replace("/my-korea#reads");
</script>
