---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Saved reads" description="Your saved K-Decoded guides.">
  <section class="mx-auto max-w-3xl px-4 py-12 sm:px-6 sm:py-16">
    <p class="text-sm font-semibold uppercase tracking-[0.16em] text-brand-700">Your K-Decoded list</p>
    <h1 class="mt-2 text-4xl font-bold tracking-tight text-gray-900">Saved reads</h1>
    <p class="mt-3 max-w-xl leading-7 text-gray-600">Keep useful guides close and come back whenever you are ready.</p>
    <div class="mt-8 grid gap-3" data-saved-reads>
      <p class="rounded-2xl border border-brand-100 bg-brand-50 p-5 text-sm text-gray-600">Loading your saved guides…</p>
    </div>
  </section>
</BaseLayout>

<script>
  const root = document.querySelector<HTMLElement>("[data-saved-reads]");
  const saved = JSON.parse(localStorage.getItem("k-decoded:saved-reads") ?? "[]") as string[];
  if (root) {
    root.innerHTML = saved.length
      ? saved.map((slug) => {
          const title = localStorage.getItem(`k-decoded:read-title:${slug}`) ?? slug.replace(/-/g, " ");
          return `<a href="/blog/${encodeURIComponent(slug)}" class="group rounded-2xl border border-brand-100 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:border-brand-300 hover:shadow-md"><span class="text-xs font-semibold uppercase tracking-[0.14em] text-brand-700">Saved guide</span><span class="mt-2 block text-lg font-bold text-gray-900 group-hover:text-brand-700">${title}</span><span class="mt-3 block text-sm font-semibold text-brand-700">Continue reading →</span></a>`;
        }).join("")
      : '<div class="rounded-2xl border border-brand-100 bg-brand-50 p-6"><h2 class="text-xl font-bold text-gray-900">Nothing saved yet.</h2><p class="mt-2 text-sm leading-6 text-gray-600">Tap “Save to reads” at the end of a guide, and it will appear here.</p><a href="/blog" class="mt-4 inline-block text-sm font-semibold text-brand-700 hover:underline">Explore the blog →</a></div>';
  }
</script>


