---
// my-korea.astro
// The "My Korea" dashboard — one page, several sections toggled by
// vanilla-JS tab buttons (same show/hide-by-class approach vocab.astro
// already uses for its tag filter chips). Everything here is rendered
// client-side from localStorage, since none of this data lives on a
// server — same reasoning saved.astro already followed.
//
// Deep-linkable via location.hash (#seoul-list, #trip, #reads, #korean,
// #checklist, #before-trip), the same technique /vocab#<slug> uses.

import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getVocabGlossary } from "../lib/vocabGlossary";

const glossary = await getVocabGlossary();
// Passed to the client script as a small lookup table (hangul -> details)
// so the My Korean panel can show a saved word's romanization/meaning
// without re-fetching or re-aggregating anything client-side.
const glossaryForClient = glossary.map(({ hangul, romanization, meaning }) => ({ hangul, romanization, meaning }));

// "Before your trip" is a fixed, hand-picked set of links, not a
// recommendation engine — titles are pulled live so they never drift
// out of sync with the actual post titles.
const posts = await getCollection("posts", ({ data }) => data.draft !== true);
const postBySlug = new Map<string, (typeof posts)[number]["data"]>(posts.map((p) => [p.slug, p.data]));
const BEFORE_TRIP_SLUGS: string[] = [
  "incheon-airport-limousine-bus-to-seoul",
  "t-money-vs-climate-card",
  "korean-restaurant-phrases",
  "seoul-esim-and-navigation-apps",
];
const beforeTripLinks = BEFORE_TRIP_SLUGS.filter((slug) => postBySlug.has(slug)).map((slug) => ({
  slug,
  title: postBySlug.get(slug)!.title,
}));

const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
const supabaseKey = import.meta.env.PUBLIC_SUPABASE_PUBLISHABLE_KEY;

const TABS = [
  { key: "overview", label: "Overview" },
  { key: "seoul-list", label: "My Seoul List" },
  { key: "trip", label: "My Trip" },
  { key: "reads", label: "My Reads" },
  { key: "korean", label: "My Korean" },
  { key: "checklist", label: "Trip Checklist" },
  { key: "before-trip", label: "Before Your Trip" },
];

const CATEGORY_FILTERS = [
  { key: "all", label: "All" },
  { key: "places", label: "Places" },
  { key: "food", label: "Food" },
  { key: "cafes", label: "Cafés" },
  { key: "beauty", label: "Beauty" },
  { key: "shopping", label: "Shopping" },
];

const DAY_LABELS: Record<string, string> = {
  day1: "Day 1",
  day2: "Day 2",
  day3: "Day 3",
  day4: "Day 4",
  day5: "Day 5",
  unscheduled: "Unscheduled",
};
---

<BaseLayout
  title="My Korea"
  description="Your Korea trip, all in one place — saved places, guides, Korean phrases, and a trip checklist."
>
  <section class="mx-auto max-w-4xl px-4 py-12 sm:px-6 sm:py-16">
    <p class="text-sm font-semibold uppercase tracking-[0.16em] text-brand-700">My Korea</p>
    <h1 class="mt-2 font-display text-4xl font-semibold leading-tight tracking-tight text-ink sm:text-5xl">Your Korea trip,<br />all in one place.</h1>
    <p class="mt-3 max-w-xl leading-7 text-ink-400">
      Save places, beauty experiences, food, guides and Korean phrases while you plan.
    </p>

    <!-- Tab nav -->
    <div class="mt-8 flex flex-wrap gap-2" id="my-korea-tabs">
      {TABS.map((tab) => (
        <button
          type="button"
          data-tab={tab.key}
          class="tab-btn rounded-md px-4 py-2.5 text-sm font-medium transition-colors data-[active=true]:bg-brand-600 data-[active=true]:text-white data-[active=false]:bg-cream-200 data-[active=false]:text-ink-400 data-[active=false]:hover:bg-cream-100 focus:outline-none focus:ring-2 focus:ring-brand-400 focus:ring-offset-2"
          data-active="false"
        >
          {tab.label}
        </button>
      ))}
    </div>

    <!-- ==================== OVERVIEW ==================== -->
    <section data-panel="overview" class="mt-8 space-y-8">
      <div class="grid grid-cols-2 gap-3 sm:grid-cols-4" id="overview-stats">
        <div class="rounded-md border border-ink-400/10 p-4 text-center">
          <p class="text-2xl font-bold text-ink" data-stat="places">0</p>
          <p class="mt-1 text-xs font-semibold uppercase tracking-wide text-ink-400">Places</p>
        </div>
        <div class="rounded-md border border-ink-400/10 p-4 text-center">
          <p class="text-2xl font-bold text-ink" data-stat="guides">0</p>
          <p class="mt-1 text-xs font-semibold uppercase tracking-wide text-ink-400">Guides</p>
        </div>
        <div class="rounded-md border border-ink-400/10 p-4 text-center">
          <p class="text-2xl font-bold text-ink" data-stat="korean">0</p>
          <p class="mt-1 text-xs font-semibold uppercase tracking-wide text-ink-400">Korean words</p>
        </div>
        <div class="rounded-md border border-ink-400/10 p-4 text-center">
          <p class="text-2xl font-bold text-ink" data-stat="checklist">0/0</p>
          <p class="mt-1 text-xs font-semibold uppercase tracking-wide text-ink-400">Trip tasks</p>
        </div>
      </div>

      <p id="overview-empty" class="hidden rounded-md border border-brand-200 bg-cream-200 p-6 text-sm leading-6 text-ink-400">
        Nothing saved yet. Look for <strong>♡ SAVE</strong> on any guide, or <strong>+ Add to Seoul list</strong> on a
        travel post, and it'll start showing up here. <a href="/blog" class="font-semibold text-brand-700 hover:underline">Explore K-Decoded →</a>
      </p>

      <!-- Account sync — reuses the existing Supabase magic-link auth, not a new backend. -->
      <div
        id="sync-card"
        class="rounded-md border border-brand-200 bg-cream-200 p-5"
        data-supabase-url={supabaseUrl}
        data-supabase-key={supabaseKey}
      >
        <h2 class="font-display text-lg font-semibold text-ink">Want to keep your Korea list across devices?</h2>
        <p class="mt-1 text-sm leading-6 text-ink-400">
          Your list is saved on this device right now. Create a free account and we'll email you a sign-in link — no password to remember.
        </p>
        <div id="sync-form" class="mt-4 grid gap-3 sm:grid-cols-[1fr_auto]">
          <label for="sync-email" class="sr-only">Email address</label>
          <input
            id="sync-email"
            type="email"
            placeholder="you@example.com"
            class="rounded-md border border-ink-400/30 px-3 py-2.5 text-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500"
          />
          <button
            type="button"
            id="sync-submit"
            class="rounded-md bg-brand-600 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-brand-700 focus:outline-none focus:ring-2 focus:ring-brand-400 focus:ring-offset-2"
          >
            Create free account →
          </button>
        </div>
        <p id="sync-status" class="mt-3 hidden text-sm font-medium text-brand-800" role="status" aria-live="polite"></p>
      </div>
    </section>

    <!-- ==================== SEOUL LIST ==================== -->
    <section data-panel="seoul-list" class="mt-8 hidden">
      <div class="flex flex-wrap gap-2" id="category-filters">
        {CATEGORY_FILTERS.map((f) => (
          <button
            type="button"
            data-category={f.key}
            data-active={f.key === "all" ? "true" : "false"}
            class="category-btn rounded-md px-3 py-1.5 text-xs font-medium transition-colors data-[active=true]:bg-brand-600 data-[active=true]:text-white data-[active=false]:bg-cream-200 data-[active=false]:text-ink-400 focus:outline-none focus:ring-2 focus:ring-brand-400 focus:ring-offset-2"
          >
            {f.label}
          </button>
        ))}
      </div>

      <div class="mt-6 grid gap-4 sm:grid-cols-2" id="seoul-list-cards"></div>

      <div id="seoul-list-empty" class="hidden rounded-md border border-brand-200 bg-cream-200 p-6">
        <h2 class="font-display text-xl font-semibold text-ink" data-empty-title>Your Seoul list</h2>
        <p class="mt-2 text-sm leading-6 text-ink-400" data-empty-body>
          Nothing saved yet. Start collecting places you don't want to forget.
        </p>
        <a href="/tags/travel" class="mt-4 inline-block text-sm font-semibold text-brand-700 hover:underline" data-empty-cta>Explore Seoul →</a>
      </div>
    </section>

    <!-- ==================== MY TRIP ==================== -->
    <section data-panel="trip" class="mt-8 hidden">
      <p class="text-sm text-ink-400">Assign places from your Seoul list to a day, then reorder or move them here.</p>
      <div class="mt-6 space-y-6" id="trip-days"></div>
      <p id="trip-empty" class="hidden rounded-md border border-brand-200 bg-cream-200 p-6 text-sm leading-6 text-ink-400">
        Nothing planned yet. Save a place, then use <strong>+ Add to trip</strong> in your Seoul list to give it a day.
      </p>
    </section>

    <!-- ==================== MY READS ==================== -->
    <section data-panel="reads" class="mt-8 hidden">
      <div class="grid gap-3" id="reads-list"></div>
      <div id="reads-empty" class="hidden rounded-md border border-brand-200 bg-cream-200 p-6">
        <h2 class="font-display text-xl font-semibold text-ink">Your reads</h2>
        <p class="mt-2 text-sm leading-6 text-ink-400">Nothing saved yet. Tap "♡ SAVE" at the end of a guide, and it'll appear here.</p>
        <a href="/blog" class="mt-4 inline-block text-sm font-semibold text-brand-700 hover:underline">Explore the blog →</a>
      </div>
    </section>

    <!-- ==================== MY KOREAN ==================== -->
    <section data-panel="korean" class="mt-8 hidden">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <p class="text-lg font-bold text-ink"><span data-korean-count>0</span> words saved</p>
        <button
          type="button"
          id="review-btn"
          class="rounded-md border border-sage-400 bg-sage-50 px-4 py-2 text-sm font-semibold text-ink-700 transition-colors hover:bg-cream-100 focus:outline-none focus:ring-2 focus:ring-brand-400 focus:ring-offset-2"
        >
          Review 5 words →
        </button>
      </div>
      <div class="mt-6 grid gap-3" id="korean-list"></div>
      <div id="korean-empty" class="hidden rounded-md border border-brand-200 bg-cream-200 p-6">
        <h2 class="font-display text-xl font-semibold text-ink">Your Korean words</h2>
        <p class="mt-2 text-sm leading-6 text-ink-400">No words saved yet. Save a word from any guide's vocab list and review it here.</p>
        <a href="/vocab" class="mt-4 inline-block text-sm font-semibold text-brand-700 hover:underline">Explore the vocab glossary →</a>
      </div>
    </section>

    <!-- ==================== TRIP CHECKLIST ==================== -->
    <section data-panel="checklist" class="mt-8 hidden">
      <ul class="space-y-2" id="checklist-items"></ul>
      <form id="checklist-add-form" class="mt-4 flex gap-2">
        <label for="checklist-add-input" class="sr-only">Add your own checklist item</label>
        <input
          id="checklist-add-input"
          type="text"
          maxlength="60"
          placeholder="Add my own item"
          class="flex-1 rounded-md border border-ink-400/30 px-3 py-2.5 text-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500"
        />
        <button
          type="submit"
          class="flex-shrink-0 rounded-md border border-brand-200 bg-cream-200 px-4 py-2.5 text-sm font-semibold text-brand-700 transition-colors hover:bg-brand-100 focus:outline-none focus:ring-2 focus:ring-brand-400 focus:ring-offset-2"
        >
          + Add my own item
        </button>
      </form>
    </section>

    <!-- ==================== BEFORE YOUR TRIP ==================== -->
    <section data-panel="before-trip" class="mt-8 hidden">
      <div id="before-trip-content">
        <h2 class="font-display text-xl font-semibold text-ink">Going to Seoul?</h2>
        <p class="mt-1 text-sm text-ink-400">You might need:</p>
        <ul class="mt-4 space-y-2">
          {beforeTripLinks.map((link) => (
            <li>
              <a href={`/blog/${link.slug}`} class="font-semibold text-brand-700 hover:underline">{link.title} →</a>
            </li>
          ))}
        </ul>
      </div>
      <p id="before-trip-empty" class="hidden rounded-md border border-brand-200 bg-cream-200 p-6 text-sm leading-6 text-ink-400">
        Save a place to your Seoul list first, and we'll surface the practical guides worth reading before you go.
      </p>
    </section>
  </section>
</BaseLayout>

<script define:vars={{ glossaryForClient, dayLabels: DAY_LABELS }}>
  // Passed in from frontmatter via define:vars — see the imports below
  // for everything else this script needs from the shared data layer.
  window.__myKoreaGlossary = glossaryForClient;
  window.__myKoreaDayLabels = dayLabels;
</script>

<script>
  import type { TripDay } from "../lib/myKorea.client";
  import {
    getSavedReads, getReadTitle, removeSavedRead,
    getSeoulList, getSeoulTitle, getSeoulListMeta, removeFromSeoulList,
    TRIP_DAYS, getTripDay, setTripDay, getTripOrder, setTripOrder, removeFromTrip,
    getSavedWords, isWordKnown, toggleKnownWord, toggleSavedWord, getWordSavedAt,
    getAllChecklistItems, getChecklistChecked, toggleChecklistItem, addChecklistItem,
  } from "../lib/myKorea.client";
  import { createClient } from "@supabase/supabase-js";

  interface GlossaryLookupEntry {
    hangul: string;
    romanization: string;
    meaning: string;
  }

  declare global {
    interface Window {
      __myKoreaGlossary?: GlossaryLookupEntry[];
      __myKoreaDayLabels?: Record<string, string>;
    }
  }

  const glossaryByHangul = new Map<string, GlossaryLookupEntry>(
    (window.__myKoreaGlossary ?? []).map((entry) => [entry.hangul, entry])
  );
  const dayLabels: Record<string, string> = window.__myKoreaDayLabels ?? {};

  // ---------- Tabs ----------
  const tabButtons = document.querySelectorAll<HTMLButtonElement>(".tab-btn");
  const panels = document.querySelectorAll<HTMLElement>("[data-panel]");

  function showTab(key: string) {
    tabButtons.forEach((btn) => btn.setAttribute("data-active", String(btn.dataset.tab === key)));
    panels.forEach((panel) => panel.classList.toggle("hidden", panel.dataset.panel !== key));
  }

  tabButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      showTab(btn.dataset.tab!);
      history.replaceState(null, "", `#${btn.dataset.tab}`);
    });
  });

  const initialTab = location.hash.replace("#", "") || "overview";
  showTab([...tabButtons].some((b) => b.dataset.tab === initialTab) ? initialTab : "overview");

  // ---------- Overview ----------
  function renderOverview() {
    const reads = getSavedReads();
    const seoulList = getSeoulList();
    const words = getSavedWords();
    const checked = getChecklistChecked();
    const allItems = getAllChecklistItems();

    document.querySelector('[data-stat="places"]')!.textContent = String(seoulList.length);
    document.querySelector('[data-stat="guides"]')!.textContent = String(reads.length);
    document.querySelector('[data-stat="korean"]')!.textContent = String(words.length);
    document.querySelector('[data-stat="checklist"]')!.textContent = `${checked.length}/${allItems.length}`;

    document.getElementById("overview-empty")!.classList.toggle(
      "hidden",
      reads.length + seoulList.length + words.length > 0
    );
  }

  // ---------- Seoul List ----------
  let activeCategory = "all";

  function seoulCardHTML(slug: string): string {
    const meta = getSeoulListMeta(slug);
    const title = getSeoulTitle(slug);
    const image = meta?.image
      ? `<img src="${meta.image}" alt="" class="h-40 w-full rounded-t-md object-cover" loading="lazy" />`
      : "";
    const categories = meta?.categories?.length
      ? meta.categories.map((c) => `<span class="rounded-full bg-brand-50 px-2 py-0.5 text-xs font-medium text-brand-700">${c}</span>`).join("")
      : "";
    const day = getTripDay(slug);
    const dayOptions = TRIP_DAYS.map(
      (d) => `<option value="${d}" ${d === day ? "selected" : ""}>${dayLabels[d] ?? d}</option>`
    ).join("");

    return `
      <article class="overflow-hidden rounded-md border border-ink-400/10 bg-white" data-seoul-card="${slug}">
        ${image}
        <div class="p-4">
          <div class="flex flex-wrap gap-1.5">${categories}</div>
          <h3 class="mt-2 font-bold text-ink">${title}</h3>
          <p class="mt-1 line-clamp-2 text-sm text-ink-400">${meta?.description ?? "Saved from K-Decoded."}</p>
          <p class="mt-2 text-xs font-semibold text-brand-700">♥ SAVED</p>
          <div class="mt-3 flex flex-wrap items-center gap-2">
            <a href="/blog/${slug}" class="text-sm font-semibold text-brand-700 hover:underline">View guide →</a>
            <label class="sr-only" for="day-${slug}">Add ${title} to trip day</label>
            <select id="day-${slug}" data-day-select="${slug}" class="ml-auto rounded-md border border-ink-400/20 px-2 py-1.5 text-xs focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500">
              ${dayOptions}
            </select>
            <button type="button" data-remove-seoul="${slug}" class="rounded-md border border-ink-400/20 px-2.5 py-1.5 text-xs font-semibold text-ink-400 hover:bg-cream-100 focus:outline-none focus:ring-2 focus:ring-brand-400 focus:ring-offset-2" aria-label="Remove ${title} from Seoul list">Remove</button>
          </div>
        </div>
      </article>`;
  }

  function renderSeoulList() {
    const list = getSeoulList();
    const filtered = list.filter((slug) => {
      if (activeCategory === "all") return true;
      const meta = getSeoulListMeta(slug);
      return meta?.categories?.includes(activeCategory) ?? false;
    });

    const container = document.getElementById("seoul-list-cards")!;
    container.innerHTML = filtered.map(seoulCardHTML).join("");

    const emptyEl = document.getElementById("seoul-list-empty")!;
    emptyEl.classList.toggle("hidden", filtered.length > 0);
    container.classList.toggle("hidden", filtered.length === 0);

    const titleEl = emptyEl.querySelector<HTMLElement>("[data-empty-title]")!;
    const bodyEl = emptyEl.querySelector<HTMLElement>("[data-empty-body]")!;
    const ctaEl = emptyEl.querySelector<HTMLAnchorElement>("[data-empty-cta]")!;
    if (activeCategory === "beauty") {
      titleEl.textContent = "Beauty experiences";
      bodyEl.textContent = "No beauty experiences saved yet. Personal color analysis, skincare clinics and more are waiting.";
      ctaEl.textContent = "Explore K-beauty →";
      ctaEl.href = "/tags/skincare";
    } else if (list.length === 0) {
      titleEl.textContent = "Your Seoul list";
      bodyEl.textContent = "Nothing saved yet. Start collecting places you don't want to forget.";
      ctaEl.textContent = "Explore Seoul →";
      ctaEl.href = "/tags/travel";
    } else {
      titleEl.textContent = "Nothing in this category yet";
      bodyEl.textContent = "Try a different filter, or keep saving places as you browse.";
      ctaEl.textContent = "Explore Seoul →";
      ctaEl.href = "/tags/travel";
    }

    container.querySelectorAll<HTMLButtonElement>("[data-remove-seoul]").forEach((btn) => {
      btn.addEventListener("click", () => {
        removeFromSeoulList(btn.dataset.removeSeoul!);
        renderSeoulList();
        renderOverview();
        renderTrip();
      });
    });
    container.querySelectorAll<HTMLSelectElement>("[data-day-select]").forEach((select) => {
      select.addEventListener("change", () => {
        setTripDay(select.dataset.daySelect!, select.value as TripDay);
        renderTrip();
      });
    });
  }

  document.querySelectorAll<HTMLButtonElement>(".category-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      activeCategory = btn.dataset.category!;
      document.querySelectorAll<HTMLButtonElement>(".category-btn").forEach((b) => b.setAttribute("data-active", String(b === btn)));
      renderSeoulList();
    });
  });

  // ---------- My Trip ----------
  // Primary interaction is explicit buttons (↑ / ↓ / move-to-day), which
  // work identically with mouse, keyboard, and touch. Drag-and-drop is
  // layered on top as a desktop nicety only — it isn't reliable enough on
  // touch to be the only way to reorder.
  function tripItemHTML(slug: string, day: TripDay, index: number, count: number): string {
    const title = getSeoulTitle(slug);
    return `
      <li draggable="true" data-trip-item="${slug}" data-day="${day}" class="flex items-center gap-2 rounded-md border border-ink-400/10 bg-white p-3">
        <span class="flex-1 text-sm font-medium text-ink">${title}</span>
        <button type="button" data-move-up="${slug}" data-day="${day}" ${index === 0 ? "disabled" : ""} class="rounded-md border border-ink-400/20 px-2 py-1 text-xs text-ink-400 hover:bg-cream-100 disabled:opacity-30 focus:outline-none focus:ring-2 focus:ring-brand-400" aria-label="Move ${title} up">↑</button>
        <button type="button" data-move-down="${slug}" data-day="${day}" ${index === count - 1 ? "disabled" : ""} class="rounded-md border border-ink-400/20 px-2 py-1 text-xs text-ink-400 hover:bg-cream-100 disabled:opacity-30 focus:outline-none focus:ring-2 focus:ring-brand-400" aria-label="Move ${title} down">↓</button>
        <button type="button" data-remove-trip="${slug}" class="rounded-md border border-ink-400/20 px-2.5 py-1 text-xs font-semibold text-ink-400 hover:bg-cream-100 focus:outline-none focus:ring-2 focus:ring-brand-400" aria-label="Remove ${title} from trip">Remove</button>
      </li>`;
  }

  function renderTrip() {
    const seoulSet = new Set(getSeoulList());
    const container = document.getElementById("trip-days")!;
    let totalPlanned = 0;

    const html = TRIP_DAYS.map((day) => {
      const order = getTripOrder(day).filter((slug) => seoulSet.has(slug));
      if (order.length === 0 && day === "unscheduled") return "";
      totalPlanned += order.length;
      const items = order.map((slug, i) => tripItemHTML(slug, day, i, order.length)).join("");
      return `
        <div>
          <h3 class="text-sm font-semibold uppercase tracking-wide text-ink-400">${dayLabels[day] ?? day}</h3>
          <ul class="mt-2 space-y-2" data-day-list="${day}">${items || '<li class="text-sm text-ink-400">Nothing yet.</li>'}</ul>
        </div>`;
    }).join("");

    container.innerHTML = html;
    document.getElementById("trip-empty")!.classList.toggle("hidden", totalPlanned > 0);
    container.classList.toggle("hidden", totalPlanned === 0);

    container.querySelectorAll<HTMLButtonElement>("[data-move-up]").forEach((btn) => {
      btn.addEventListener("click", () => reorder(btn.dataset.day as TripDay, btn.dataset.moveUp!, -1));
    });
    container.querySelectorAll<HTMLButtonElement>("[data-move-down]").forEach((btn) => {
      btn.addEventListener("click", () => reorder(btn.dataset.day as TripDay, btn.dataset.moveDown!, 1));
    });
    container.querySelectorAll<HTMLButtonElement>("[data-remove-trip]").forEach((btn) => {
      btn.addEventListener("click", () => {
        removeFromTrip(btn.dataset.removeTrip!);
        renderTrip();
        renderSeoulList();
      });
    });

    // Desktop drag-and-drop, layered on top of the button controls above.
    let dragSlug: string | null = null;
    container.querySelectorAll<HTMLLIElement>("[data-trip-item]").forEach((li) => {
      li.addEventListener("dragstart", () => { dragSlug = li.dataset.tripItem ?? null; });
    });
    container.querySelectorAll<HTMLUListElement>("[data-day-list]").forEach((list) => {
      list.addEventListener("dragover", (e) => e.preventDefault());
      list.addEventListener("drop", (e) => {
        e.preventDefault();
        if (!dragSlug) return;
        const day = list.dataset.dayList as TripDay;
        const order = getTripOrder(day).filter((s) => s !== dragSlug);
        order.push(dragSlug);
        setTripDay(dragSlug, day);
        setTripOrder(day, order);
        dragSlug = null;
        renderTrip();
      });
    });
  }

  function reorder(day: TripDay, slug: string, delta: number) {
    const order = getTripOrder(day);
    const index = order.indexOf(slug);
    const target = index + delta;
    if (index === -1 || target < 0 || target >= order.length) return;
    [order[index], order[target]] = [order[target], order[index]];
    setTripOrder(day, order);
    renderTrip();
  }

  // ---------- My Reads ----------
  function renderReads() {
    const reads = getSavedReads();
    const container = document.getElementById("reads-list")!;
    container.innerHTML = reads.map((slug) => {
      const title = getReadTitle(slug);
      return `
        <div class="flex items-center gap-3 rounded-md border border-ink-400/10 bg-white p-4">
          <a href="/blog/${slug}" class="flex-1 text-sm font-semibold text-ink hover:text-brand-700">${title}</a>
          <a href="/blog/${slug}" class="text-sm font-semibold text-brand-700 hover:underline">Read →</a>
          <button type="button" data-remove-read="${slug}" class="rounded-md border border-ink-400/20 px-2.5 py-1.5 text-xs font-semibold text-ink-400 hover:bg-cream-100 focus:outline-none focus:ring-2 focus:ring-brand-400" aria-label="Remove ${title} from My Reads">Remove</button>
        </div>`;
    }).join("");

    document.getElementById("reads-empty")!.classList.toggle("hidden", reads.length > 0);
    container.classList.toggle("hidden", reads.length === 0);

    container.querySelectorAll<HTMLButtonElement>("[data-remove-read]").forEach((btn) => {
      btn.addEventListener("click", () => {
        removeSavedRead(btn.dataset.removeRead!);
        renderReads();
        renderOverview();
      });
    });
  }

  // ---------- My Korean ----------
  function koreanEntryHTML(hangul: string): string {
    const entry = glossaryByHangul.get(hangul);
    const known = isWordKnown(hangul);
    return `
      <div class="flex flex-wrap items-center gap-x-3 gap-y-1 rounded-md border border-ink-400/10 bg-white p-4">
        <span class="font-korean text-lg font-bold text-brand-800">${hangul}</span>
        <span class="text-sm italic text-brand-600">${entry?.romanization ?? ""}</span>
        <span class="text-sm text-ink-700">${entry?.meaning ?? ""}</span>
        <button type="button" data-known="${hangul}" class="ml-auto rounded-md border border-sage-400 px-2.5 py-1 text-xs font-semibold text-ink-700 hover:bg-sage-50 focus:outline-none focus:ring-2 focus:ring-brand-400" aria-pressed="${known}">${known ? "✓ Known" : "Mark as known"}</button>
        <button type="button" data-unsave-word="${hangul}" class="rounded-md border border-ink-400/20 px-2.5 py-1 text-xs font-semibold text-ink-400 hover:bg-cream-100 focus:outline-none focus:ring-2 focus:ring-brand-400" aria-label="Remove ${hangul} from saved words">Remove</button>
      </div>`;
  }

  let reviewMode = false;

  function renderKorean() {
    const words = getSavedWords();
    document.querySelector("[data-korean-count]")!.textContent = String(words.length);

    const sorted = [...words].sort((a, b) => (getWordSavedAt(b) ?? "").localeCompare(getWordSavedAt(a) ?? ""));
    const list = reviewMode ? sorted.filter((w) => !isWordKnown(w)).slice(0, 5) : sorted;

    const container = document.getElementById("korean-list")!;
    container.innerHTML = list.map(koreanEntryHTML).join("");
    document.getElementById("korean-empty")!.classList.toggle("hidden", words.length > 0);
    container.classList.toggle("hidden", words.length === 0);

    container.querySelectorAll<HTMLButtonElement>("[data-known]").forEach((btn) => {
      btn.addEventListener("click", () => { toggleKnownWord(btn.dataset.known!); renderKorean(); });
    });
    container.querySelectorAll<HTMLButtonElement>("[data-unsave-word]").forEach((btn) => {
      btn.addEventListener("click", () => { toggleSavedWord(btn.dataset.unsaveWord!); renderKorean(); });
    });
  }

  const reviewBtn = document.getElementById("review-btn")!;
  reviewBtn.addEventListener("click", () => {
    reviewMode = !reviewMode;
    reviewBtn.textContent = reviewMode ? "Show all saved words" : "Review 5 words →";
    renderKorean();
  });

  // ---------- Trip checklist ----------
  function renderChecklist() {
    const checked = new Set(getChecklistChecked());
    const items = getAllChecklistItems();
    const container = document.getElementById("checklist-items")!;
    container.innerHTML = items.map((item) => `
      <li class="flex items-center gap-3">
        <input type="checkbox" id="check-${item.id}" data-checklist-item="${item.id}" ${checked.has(item.id) ? "checked" : ""} class="h-5 w-5 flex-shrink-0 rounded border-ink-400/30 text-brand-600 focus:ring-brand-500" />
        <label for="check-${item.id}" class="text-sm text-ink-700">${item.label}</label>
      </li>`).join("");

    container.querySelectorAll<HTMLInputElement>("[data-checklist-item]").forEach((input) => {
      input.addEventListener("change", () => {
        toggleChecklistItem(input.dataset.checklistItem!);
        renderOverview();
      });
    });
  }

  document.getElementById("checklist-add-form")!.addEventListener("submit", (e) => {
    e.preventDefault();
    const input = document.getElementById("checklist-add-input") as HTMLInputElement;
    const label = input.value.trim();
    if (!label) return;
    addChecklistItem(label);
    input.value = "";
    renderChecklist();
    renderOverview();
  });

  // ---------- Before your trip ----------
  function renderBeforeTrip() {
    const hasContent = getSeoulList().length > 0 || getSavedReads().length > 0;
    document.getElementById("before-trip-content")!.classList.toggle("hidden", !hasContent);
    document.getElementById("before-trip-empty")!.classList.toggle("hidden", hasContent);
  }

  // ---------- Account sync (reuses the existing Supabase magic-link auth) ----------
  const syncCard = document.getElementById("sync-card");
  const syncStatus = document.getElementById("sync-status")!;
  const supabaseUrl = syncCard?.dataset.supabaseUrl;
  const supabaseKey = syncCard?.dataset.supabaseKey;

  function sayStatus(message: string) {
    syncStatus.textContent = message;
    syncStatus.classList.remove("hidden");
  }

  if (supabaseUrl && supabaseKey) {
    const supabase = createClient(supabaseUrl, supabaseKey);
    supabase.auth.getUser().then(({ data }) => {
      if (data.user) {
        document.getElementById("sync-form")?.classList.add("hidden");
        sayStatus(`Signed in as ${data.user.email}. Your list stays on this device for now — cross-device sync is coming soon.`);
      }
    });

    document.getElementById("sync-submit")?.addEventListener("click", async () => {
      const email = (document.getElementById("sync-email") as HTMLInputElement | null)?.value.trim();
      if (!email) return sayStatus("Enter your email address.");
      const { error } = await supabase.auth.signInWithOtp({
        email,
        options: { emailRedirectTo: new URL("/my-korea", location.origin).toString() },
      });
      sayStatus(error ? "Could not send sign-in link. Please try again." : "Check your inbox for the sign-in link.");
    });
  } else {
    syncCard?.classList.add("hidden");
  }

  // ---------- Initial render ----------
  renderOverview();
  renderSeoulList();
  renderTrip();
  renderReads();
  renderKorean();
  renderChecklist();
  renderBeforeTrip();
</script>
