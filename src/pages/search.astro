---
// src/pages/search.astro
// Site search. Because this is a fully static site with no backend, the
// search box in the header just submits a plain GET form to this page
// (?q=...) — no JavaScript required for that part, it's standard HTML.
// This page then embeds every post's searchable fields once at build
// time and filters them client-side as the visitor types, the same
// pattern already used for the vocab glossary's search box.

import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getTagColor } from "../lib/tagColors";

const posts = await getCollection("posts", ({ data }) => data.draft !== true);
const sortedPosts = posts.sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<BaseLayout
  title="Search"
  description="Search every K-Decoded post by title, description, or tag."
>
  <section class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
    <h1 class="text-3xl font-bold text-gray-900">Search</h1>

    <form action="/search" method="get" class="mt-6">
      <input
        id="search-input"
        name="q"
        type="search"
        placeholder="Search posts by title, topic, or tag…"
        class="w-full rounded-lg border border-gray-300 px-4 py-2.5 text-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500"
      />
    </form>

    <p id="search-empty-state" class="mt-6 hidden text-sm text-gray-400">
      No posts match that search.
    </p>

    <ul class="mt-8 space-y-4" id="search-results">
      {sortedPosts.map((post) => (
        <li
          class="search-result rounded-xl border border-gray-100 p-4 transition-shadow hover:shadow-md"
          data-search={`${post.data.title} ${post.data.description} ${post.data.tags.join(" ")}`.toLowerCase()}
        >
          <a href={`/blog/${post.slug}`}>
            <h2 class="font-semibold text-gray-900 hover:text-brand-600">{post.data.title}</h2>
            <p class="mt-1 text-sm text-gray-600">{post.data.description}</p>
            {post.data.tags.length > 0 && (
              <ul class="mt-2 flex flex-wrap gap-2">
                {post.data.tags.map((tag) => (
                  <li class:list={["rounded-full px-2.5 py-1 text-xs font-medium", getTagColor(tag)]}>
                    {tag}
                  </li>
                ))}
              </ul>
            )}
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<script>
  // Reads ?q= from the URL (set by the header's search form), pre-fills
  // the input, and filters the embedded post list — then keeps filtering
  // live as the visitor types further, exactly like the vocab glossary.
  const searchInput = document.getElementById("search-input") as HTMLInputElement | null;
  const results = document.querySelectorAll<HTMLLIElement>(".search-result");
  const emptyState = document.getElementById("search-empty-state");

  function applyFilter(query: string) {
    const normalized = query.trim().toLowerCase();
    let visibleCount = 0;

    results.forEach((result) => {
      const isVisible = result.dataset.search?.includes(normalized) ?? true;
      result.classList.toggle("hidden", !isVisible);
      if (isVisible) visibleCount++;
    });

    emptyState?.classList.toggle("hidden", visibleCount > 0 || normalized === "");
  }

  const initialQuery = new URLSearchParams(window.location.search).get("q") ?? "";
  if (searchInput) {
    searchInput.value = initialQuery;
    applyFilter(initialQuery);
    searchInput.addEventListener("input", () => applyFilter(searchInput.value));
  }
</script>
