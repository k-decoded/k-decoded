---
// src/pages/about.astro
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="About"
  description="What K-Decoded is and who it's for."
>
  <section class="mx-auto max-w-2xl px-4 py-16 sm:px-6">
    <h1 class="text-3xl font-bold text-gray-900">About K-Decoded</h1>
    <div class="prose prose-brand mt-6 max-w-none">
      <p>
        K-Decoded exists for anyone who loves Korean beauty and fashion but
        hits a wall the moment a product label, shopping site, or ingredient
        list shows up in Hangul.
      </p>
      <p>
        Every post decodes something real — a product, a trend, a shopping
        site — and along the way teaches you the actual Korean words behind
        it, so the next label you see is a little less of a mystery.
      </p>
      <p>
        No account needed, nothing to buy to read the site. Just decoding,
        one post at a time.
      </p>
    </div>
  </section>
</BaseLayout>
