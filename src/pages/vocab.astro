---
// src/pages/vocab.astro
// Auto-aggregates every vocab entry used across every post into one
// searchable, filterable glossary. You never edit this page directly —
// add a `vocab` entry to any post's frontmatter and it shows up here
// automatically on the next build.

import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const posts = await getCollection("posts", ({ data }) => data.draft !== true);

// De-duplicate vocab entries by hangul: if the same word appears in
// multiple posts, show it once with links to every post that uses it.
type GlossaryEntry = {
  hangul: string;
  romanization: string;
  meaning: string;
  tags: Set<string>;
  sources: { title: string; slug: string }[];
};

const glossaryMap = new Map<string, GlossaryEntry>();

for (const post of posts) {
  for (const entry of post.data.vocab) {
    const existing = glossaryMap.get(entry.hangul);
    if (existing) {
      existing.sources.push({ title: post.data.title, slug: post.slug });
      post.data.tags.forEach((tag) => existing.tags.add(tag));
    } else {
      glossaryMap.set(entry.hangul, {
        ...entry,
        tags: new Set(post.data.tags),
        sources: [{ title: post.data.title, slug: post.slug }],
      });
    }
  }
}

const glossary = Array.from(glossaryMap.values()).sort((a, b) =>
  a.romanization.localeCompare(b.romanization)
);

// Turns a romanization like "jaoeseon chadanje" into a URL-safe anchor id
// like "jaoeseon-chadanje". Post bodies link to /vocab#<this> so an inline
// Korean word jumps straight to its glossary entry (and from there, to
// every other post that uses the same word).
function slugify(romanization: string) {
  return romanization.trim().toLowerCase().replace(/\s+/g, "-");
}

// Every unique tag across the whole glossary, for the filter chips below.
const allTags = Array.from(
  new Set(glossary.flatMap((entry) => Array.from(entry.tags)))
).sort();
---

<BaseLayout
  title="Vocab Glossary"
  description="Every Korean beauty, fashion, and language term explained across K-Decoded, in one searchable glossary."
>
  <section class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
    <h1 class="text-3xl font-bold text-gray-900">Vocab Glossary</h1>
    <p class="mt-2 text-gray-600">
      Every Korean word we've taught across all posts, collected in one place.
    </p>
    <p id="vocab-progress" class="mt-3 inline-flex rounded-full bg-teal-50 px-3 py-1 text-sm font-medium text-teal-800">0 words marked as known</p>

    <!-- Search + filter controls. No JS framework — just a plain input
         and buttons, wired up by the <script> at the bottom of this file. -->
    <div class="mt-8 space-y-4">
      <input
        id="vocab-search"
        type="search"
        placeholder="Search hangul, romanization, or meaning…"
        class="w-full rounded-lg border border-gray-300 px-4 py-2.5 text-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500"
      />

      {allTags.length > 0 && (
        <div class="flex flex-wrap gap-2" id="vocab-tag-filters">
          <button
            type="button"
            data-tag="all"
            class="tag-filter-btn rounded-full bg-brand-600 px-3 py-1 text-xs font-medium text-white"
          >
            All
          </button>
          {allTags.map((tag) => (
            <button
              type="button"
              data-tag={tag}
              class="tag-filter-btn rounded-full bg-gray-100 px-3 py-1 text-xs font-medium text-gray-600 hover:bg-gray-200"
            >
              {tag}
            </button>
          ))}
        </div>
      )}
    </div>

    <p id="vocab-empty-state" class="mt-6 hidden text-sm text-gray-400">
      No matching terms.
    </p>

    <ul class="mt-8 divide-y divide-gray-100" id="vocab-list">
      {glossary.map((entry) => (
        <li
          id={slugify(entry.romanization)}
          class="vocab-entry scroll-mt-24 py-4 target:rounded-lg target:bg-brand-50 target:ring-1 target:ring-brand-200"
          data-search={`${entry.hangul} ${entry.romanization} ${entry.meaning}`.toLowerCase()}
          data-tags={Array.from(entry.tags).join(",")}
        >
          <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
            <span class="font-korean text-xl font-bold text-brand-800">{entry.hangul}</span>
            <span class="text-sm italic text-brand-600">{entry.romanization}</span>
            <span class="text-sm text-gray-700">— {entry.meaning}</span>
          </div>
          <button type="button" class="vocab-known-btn mt-2 rounded-full border border-teal-200 px-2.5 py-1 text-xs font-semibold text-teal-800 transition-colors hover:bg-teal-50" data-word={entry.hangul}>Mark as known</button>
          <p class="mt-1 text-xs text-gray-400">
            From:{" "}
            {entry.sources.map((source, i) => (
              <>
                {i > 0 && ", "}
                <a href={`/blog/${source.slug}`} class="underline hover:text-brand-600">
                  {source.title}
                </a>
              </>
            ))}
          </p>
        </li>
      ))}
    </ul>

    {glossary.length === 0 && (
      <p class="mt-8 text-gray-500">
        No vocab yet — add a <code>vocab</code> array to a post's frontmatter to get started.
      </p>
    )}

    <!-- Pagination for the default (unsearched, "All") view — a growing
         glossary shouldn't turn into one endless scroll. Hidden whenever
         a search/tag filter is active, since a filtered result set is
         short enough to just show in full. -->
    <div id="vocab-pagination" class="mt-8 hidden items-center justify-center gap-4">
      <button
        type="button"
        id="vocab-prev-btn"
        class="rounded-full border border-brand-200 px-4 py-1.5 text-sm font-medium text-brand-700 transition-colors hover:bg-brand-50 disabled:cursor-not-allowed disabled:opacity-40"
      >
        ← Prev
      </button>
      <span id="vocab-page-label" class="text-sm text-gray-500"></span>
      <button
        type="button"
        id="vocab-next-btn"
        class="rounded-full border border-brand-200 px-4 py-1.5 text-sm font-medium text-brand-700 transition-colors hover:bg-brand-50 disabled:cursor-not-allowed disabled:opacity-40"
      >
        Next →
      </button>
    </div>
  </section>
</BaseLayout>

<script>
  // Plain vanilla JS: filters the glossary list client-side as the user
  // types or clicks a tag chip, and paginates the default (unfiltered)
  // view so the page doesn't just keep growing as more posts add vocab.
  // Runs entirely in the browser after the static HTML loads — no
  // server, no framework, no build step of its own.
  const PAGE_SIZE = 15;

  const searchInput = document.getElementById("vocab-search") as HTMLInputElement | null;
  const tagButtons = document.querySelectorAll<HTMLButtonElement>(".tag-filter-btn");
  const entries = Array.from(document.querySelectorAll<HTMLLIElement>(".vocab-entry"));
  const emptyState = document.getElementById("vocab-empty-state");
  const paginationEl = document.getElementById("vocab-pagination");
  const prevButton = document.getElementById("vocab-prev-btn") as HTMLButtonElement | null;
  const nextButton = document.getElementById("vocab-next-btn") as HTMLButtonElement | null;
  const pageLabel = document.getElementById("vocab-page-label");
  const progressLabel = document.getElementById("vocab-progress");
  const knownWordsKey = "k-decoded:known-words";
  const knownWords = new Set<string>(JSON.parse(localStorage.getItem(knownWordsKey) ?? "[]"));

  function renderKnownWords() {
    progressLabel!.textContent = `${knownWords.size} word${knownWords.size === 1 ? "" : "s"} marked as known`;
    document.querySelectorAll<HTMLButtonElement>(".vocab-known-btn").forEach((button) => {
      const known = knownWords.has(button.dataset.word ?? "");
      button.textContent = known ? "✓ Known" : "Mark as known";
      button.setAttribute("aria-pressed", String(known));
    });
  }

  document.querySelectorAll<HTMLButtonElement>(".vocab-known-btn").forEach((button) => {
    button.addEventListener("click", () => {
      const word = button.dataset.word;
      if (!word) return;
      knownWords.has(word) ? knownWords.delete(word) : knownWords.add(word);
      localStorage.setItem(knownWordsKey, JSON.stringify([...knownWords]));
      renderKnownWords();
    });
  });

  let activeTag = "all";
  let currentPage = 1;

  function applyFilters() {
    const query = (searchInput?.value ?? "").trim().toLowerCase();
    const isDefaultView = query === "" && activeTag === "all";

    const matching = entries.filter((entry) => {
      const matchesSearch = entry.dataset.search?.includes(query) ?? true;
      const entryTags = entry.dataset.tags?.split(",") ?? [];
      const matchesTag = activeTag === "all" || entryTags.includes(activeTag);
      return matchesSearch && matchesTag;
    });

    // Only paginate the default "everything, unfiltered" view — a
    // search or tag filter usually narrows things down enough that
    // showing all matches at once is more useful than paging through them.
    let visible: HTMLLIElement[];
    if (isDefaultView && matching.length > PAGE_SIZE) {
      const totalPages = Math.ceil(matching.length / PAGE_SIZE);
      currentPage = Math.min(Math.max(1, currentPage), totalPages);
      const start = (currentPage - 1) * PAGE_SIZE;
      visible = matching.slice(start, start + PAGE_SIZE);
      renderPagination(currentPage, totalPages);
    } else {
      visible = matching;
      renderPagination(0, 0);
    }

    const visibleSet = new Set(visible);
    entries.forEach((entry) => {
      entry.classList.toggle("hidden", !visibleSet.has(entry));
    });

    emptyState?.classList.toggle("hidden", matching.length > 0);
  }

  function renderPagination(page: number, totalPages: number) {
    if (!paginationEl || !prevButton || !nextButton || !pageLabel) return;

    if (totalPages <= 1) {
      paginationEl.classList.add("hidden");
      return;
    }

    paginationEl.classList.remove("hidden");
    pageLabel.textContent = `Page ${page} of ${totalPages}`;
    prevButton.disabled = page <= 1;
    nextButton.disabled = page >= totalPages;
  }

  // If a post links to /vocab#some-term, that entry might be on what
  // would otherwise be page 2 or 3 — jump to the right page first, then
  // scroll to it, so the deep link still works with pagination in place.
  function goToEntryFromHash() {
    const id = window.location.hash.replace("#", "");
    if (!id) {
      applyFilters();
      return;
    }

    const index = entries.findIndex((entry) => entry.id === id);
    if (index === -1) {
      applyFilters();
      return;
    }

    currentPage = Math.floor(index / PAGE_SIZE) + 1;
    applyFilters();
    entries[index].scrollIntoView({ block: "center" });
  }

  searchInput?.addEventListener("input", () => {
    currentPage = 1;
    applyFilters();
  });

  tagButtons.forEach((button) => {
    button.addEventListener("click", () => {
      activeTag = button.dataset.tag ?? "all";
      currentPage = 1;

      // Toggle active styling on the clicked chip.
      tagButtons.forEach((btn) => {
        btn.classList.remove("bg-brand-600", "text-white");
        btn.classList.add("bg-gray-100", "text-gray-600");
      });
      button.classList.remove("bg-gray-100", "text-gray-600");
      button.classList.add("bg-brand-600", "text-white");

      applyFilters();
    });
  });

  prevButton?.addEventListener("click", () => {
    currentPage--;
    applyFilters();
    document.getElementById("vocab-list")?.scrollIntoView({ block: "start" });
  });

  nextButton?.addEventListener("click", () => {
    currentPage++;
    applyFilters();
    document.getElementById("vocab-list")?.scrollIntoView({ block: "start" });
  });

  goToEntryFromHash();
  renderKnownWords();
</script>
