---
// src/pages/contact.astro
// A simple contact page: a mailto link, no backend or form service
// needed, so it works immediately with zero setup. If you'd rather have
// a real embedded form later, see the note in README.md about swapping
// this for a free service like Formspree.

import BaseLayout from "../layouts/BaseLayout.astro";

const CONTACT_EMAIL = "hello@k-decoded.com";
---

<BaseLayout
  title="Contact"
  description="Get in touch with K-Decoded — questions, corrections, or collab pitches welcome."
>
  <section class="mx-auto max-w-2xl px-4 py-16 sm:px-6">
    <h1 class="text-3xl font-bold text-gray-900">Get in touch</h1>
    <p class="mt-4 text-gray-600">
      Spotted a mistranslation? Want a specific product or brand decoded?
      Have a collab or partnership pitch? All of it's welcome — a real
      person reads every message.
    </p>

    <div class="mt-8 flex flex-wrap items-center gap-3">
      <a
        href={`mailto:${CONTACT_EMAIL}`}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-full bg-gradient-to-r from-brand-600 to-orange-500 px-6 py-3 text-sm font-semibold text-white shadow-md transition-transform duration-200 hover:scale-105 hover:shadow-lg"
      >
        Email {CONTACT_EMAIL}
      </a>

      <!-- Fallback for visitors with no default mail app configured —
           mailto: only works if the OS/browser has one registered, so
           this lets anyone grab the address and paste it wherever they
           actually check mail. -->
      <button
        type="button"
        id="copy-email-btn"
        data-email={CONTACT_EMAIL}
        class="rounded-full border border-brand-200 px-5 py-3 text-sm font-medium text-brand-700 transition-colors hover:bg-brand-50"
      >
        Copy email address
      </button>
    </div>

    <p id="copy-feedback" class="mt-3 hidden text-sm font-medium" aria-live="polite"></p>

    <p class="mt-6 text-sm text-gray-500">
      Prefer to keep it public? Every post has a comment section at the
      bottom — questions there are visible to other readers too, in case
      someone else has the same one.
    </p>
  </section>
</BaseLayout>

<script>
  // Copies the contact email to the clipboard when the mailto link can't
  // launch a mail app (no default configured on the visitor's system).
  // Falls back to the older execCommand approach if the modern Clipboard
  // API is unavailable or denied, and if even that fails, at least tells
  // the visitor the address instead of failing silently.
  const copyButton = document.getElementById("copy-email-btn");
  const feedback = document.getElementById("copy-feedback");
  let hideTimeout: ReturnType<typeof setTimeout> | undefined;

  function showFeedback(message: string, isError: boolean) {
    if (!feedback) return;
    feedback.textContent = message;
    feedback.classList.toggle("text-green-600", !isError);
    feedback.classList.toggle("text-red-600", isError);
    feedback.classList.remove("hidden");
    clearTimeout(hideTimeout);
    hideTimeout = setTimeout(() => feedback.classList.add("hidden"), 4000);
  }

  function copyWithFallback(text: string): boolean {
    const textarea = document.createElement("textarea");
    textarea.value = text;
    textarea.style.position = "fixed";
    textarea.style.opacity = "0";
    document.body.appendChild(textarea);
    textarea.focus();
    textarea.select();
    const succeeded = document.execCommand("copy");
    document.body.removeChild(textarea);
    return succeeded;
  }

  copyButton?.addEventListener("click", async () => {
    const email = copyButton.dataset.email ?? "";

    try {
      await navigator.clipboard.writeText(email);
      showFeedback(`Copied ${email} to your clipboard.`, false);
    } catch {
      const succeeded = copyWithFallback(email);
      if (succeeded) {
        showFeedback(`Copied ${email} to your clipboard.`, false);
      } else {
        showFeedback(`Couldn't copy automatically — the address is ${email}.`, true);
      }
    }
  });
</script>
