---
import BaseLayout from "../layouts/BaseLayout.astro";

const themes = {
  food: { label: "Korean Food", entries: [["Tteokbokki", "떡볶이"], ["Korean Fried Chicken", "치킨"], ["Kimchi Jjigae", "김치찌개"], ["Bibimbap", "비빔밥"], ["Kimbap", "김밥"], ["Japchae", "잡채"], ["Hotteok", "호떡"], ["Bingsu", "빙수"]] },
  beauty: { label: "K-Beauty", entries: [["Sheet Mask", "시트 마스크"], ["Lip Tint", "립 틴트"], ["Cushion Foundation", "쿠션"], ["Sunscreen", "선크림"], ["Cleansing Oil", "클렌징 오일"], ["Essence", "에센스"], ["Toner", "토너"], ["Pimple Patch", "여드름 패치"]] },
  landmarks: { label: "Seoul Landmarks", entries: [["Gyeongbokgung", "경복궁"], ["N Seoul Tower", "N서울타워"], ["Bukchon", "북촌"], ["Han River", "한강"], ["Myeongdong", "명동"], ["Hongdae", "홍대"], ["Ikseon-dong", "익선동"], ["DDP", "동대문디자인플라자"]] },
};
---

<BaseLayout title="Play" description="Take a quick K-Decoded culture break with the Korean Mini World Cup.">
  <main class="min-h-[70vh] bg-gradient-to-br from-brand-50 via-orange-50 to-teal-50 px-4 py-12 sm:px-6 sm:py-16">
    <section class="mx-auto max-w-3xl">
      <p class="text-center text-sm font-semibold uppercase tracking-[0.18em] text-brand-700">K-Decoded Play</p>
      <h1 class="mt-2 text-center text-4xl font-bold tracking-tight text-gray-900 sm:text-5xl">Korean Mini World Cup</h1>
      <p class="mx-auto mt-4 max-w-xl text-center leading-7 text-gray-600">Seven quick choices. One personal champion. A small culture break between guides.</p>

      <div class="mt-8 rounded-3xl border border-white/80 bg-white/85 p-5 shadow-xl shadow-brand-900/10 sm:p-8">
        <div class="flex flex-wrap justify-center gap-2" role="tablist" aria-label="Choose a Mini World Cup theme">
          {Object.entries(themes).map(([key, theme], index) => (
            <button type="button" role="tab" aria-selected={index === 0 ? "true" : "false"} class:list={["rounded-full border px-4 py-2 text-sm font-semibold transition-colors", index === 0 ? "border-brand-300 bg-brand-100 text-brand-800" : "border-gray-200 bg-white text-gray-600 hover:border-brand-300 hover:bg-brand-50"]} data-play-theme={key}>{theme.label}</button>
          ))}
        </div>
        <div class="mt-7 border-t border-brand-100 pt-5">
          <div class="flex items-center justify-between text-xs font-semibold uppercase tracking-[0.14em]">
            <span class="text-gray-500" data-play-progress>Choice 1 of 7</span>
            <span class="text-brand-700" data-play-stage>Quarterfinal</span>
          </div>
          <div class="mt-4" aria-live="polite" data-play-match></div>
        </div>
      </div>
      <p class="mt-6 text-center text-sm text-gray-500">Want practical help instead? <a href="/blog" class="font-semibold text-brand-700 underline decoration-brand-300 underline-offset-4">Explore the guides</a>.</p>
    </section>
  </main>
</BaseLayout>

<script define:vars={{ themes }}>
  const match = document.querySelector("[data-play-match]");
  const progress = document.querySelector("[data-play-progress]");
  const stage = document.querySelector("[data-play-stage]");
  const buttons = document.querySelectorAll("[data-play-theme]");
  let activeKey = "food";
  let round = [];
  let picks = 0;

  function makeButton(entry, index) {
    return `<button type="button" class="min-h-32 rounded-2xl border border-brand-200 bg-white p-4 text-left shadow-sm transition hover:-translate-y-0.5 hover:border-brand-400 hover:bg-brand-50 hover:shadow-md focus:outline-none focus:ring-2 focus:ring-brand-400" data-choice="${index}"><span class="block text-lg font-bold text-gray-900">${entry[0]}</span><span lang="ko" class="mt-2 block font-korean text-sm font-semibold text-teal-700">${entry[1]}</span></button>`;
  }

  function renderRound() {
    const stageLabels = { 8: "Quarterfinal", 4: "Semifinal", 2: "Final" };
    stage.textContent = stageLabels[round.length] ?? "Champion";
    if (round.length === 1) {
      progress.textContent = "Your champion";
      match.innerHTML = `<div class="animate-fade-in-up py-4 text-center"><p class="text-sm font-semibold uppercase tracking-[0.14em] text-brand-700">Your ${themes[activeKey].label} champion</p><h2 class="mt-3 text-4xl font-bold text-gray-900">${round[0][0]}</h2><p lang="ko" class="mt-2 font-korean text-xl font-semibold text-teal-700">${round[0][1]}</p><button type="button" class="mt-6 rounded-full bg-gradient-to-r from-brand-600 to-orange-500 px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:scale-105" data-restart>Play again</button></div>`;
      match.querySelector("[data-restart]")?.addEventListener("click", start);
      return;
    }
    progress.textContent = `Choice ${picks + 1} of 7`;
    match.innerHTML = `<div class="grid grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] items-stretch gap-3">${makeButton(round[0], 0)}<span class="self-center text-sm font-semibold italic text-gray-400">vs</span>${makeButton(round[1], 1)}</div>`;
    match.querySelectorAll("[data-choice]").forEach((choice) => choice.addEventListener("click", () => choose(Number(choice.dataset.choice))));
  }

  function choose(index) {
    const winner = round[index];
    const remaining = round.slice(2);
    const winners = (match.dataset.winners ? JSON.parse(match.dataset.winners) : []);
    winners.push(winner);
    picks += 1;
    if (remaining.length) {
      match.dataset.winners = JSON.stringify(winners);
      round = remaining;
    } else {
      match.dataset.winners = "";
      round = winners;
    }
    renderRound();
  }

  function start() {
    round = [...themes[activeKey].entries];
    picks = 0;
    match.dataset.winners = "";
    renderRound();
  }

  buttons.forEach((button) => button.addEventListener("click", () => {
    activeKey = button.dataset.playTheme;
    buttons.forEach((item) => {
      const active = item === button;
      item.setAttribute("aria-selected", String(active));
      item.classList.toggle("border-brand-300", active);
      item.classList.toggle("bg-brand-100", active);
      item.classList.toggle("text-brand-800", active);
      item.classList.toggle("border-gray-200", !active);
      item.classList.toggle("bg-white", !active);
      item.classList.toggle("text-gray-600", !active);
    });
    start();
  }));
  start();
</script>


